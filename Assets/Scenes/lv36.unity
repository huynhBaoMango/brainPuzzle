  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv36
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: khanlau
    stateId: used_dautay
    target: {fileID: 0}
  - type: 0
    targetId: khanlau
    stateId: used_dauchan
    target: {fileID: 0}
  - type: 0
    targetId: cuamo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: guoc
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: daydien
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: banpc
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: bangkeo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: chan1
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: chuichan
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: chiakhoa
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: win
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: win2
    target: {fileID: 0}
  loseConditions: []
  timeLimit: 90
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Midnight
    vn: "N\u1EEDa \u0111\xEAm"
  - key: des
    en: Eliminate all hazards in the room
    vn: "Lo\u1EA1i tr\u1EEB t\u1EA5t c\u1EA3 m\u1ED1i nguy trong c\u0103n ph\xF2ng "
  - key: cuamo_s
    en: There's something creepy hanging out the door
    vn: "C\xF3 g\xEC \u0111\xF3 th\u1EADp th\xF2 ngo\xE0i c\u1EEDa th\u1EADt \u0111\xE1ng
      s\u1EE3"
  - key: cuamo_h
    en: Click on the door to close it
    vn: "B\u1EA5m v\xE0o c\u1EEDa \u0111\u1EC3 \u0111\xF3ng l\u1EA1i"
  - key: guoc_s
    en: No more seeing that scary shadow
    vn: "Kh\xF4ng c\xF2n th\u1EA5y c\xE1i b\xF3ng \u0111\xE1ng s\u1EE3 \u0111\xF3
      n\u1EEFa"
  - key: guoc_h
    en: Pull the clogs into the mirror
    vn: "K\xE9o \u0111\xF4i gu\u1ED1c v\xE0o c\xE1i g\u01B0\u01A1ng"
  - key: chiakhoa_s
    en: Lock one more time to make sure
    vn: "Kh\xF3a th\xEAm m\u1ED9t kh\xF3a l\u1EA7n n\u1EEFa cho ch\u1EAFc"
  - key: chiakhoa_h
    en: Pull the key into the door
    vn: "K\xE9o ch\xECa kh\xF3a v\xE0o c\u1EEDa"
  - key: thamchuichan_h
    en: Swipe down the doormat
    vn: "Vu\u1ED1t th\u1EA3m ch\xF9i ch\xE2n xu\u1ED1ng"
  - key: khanlaudautay_s
    en: These fingerprints are scary
    vn: "M\u1EA5y c\xE1i d\u1EA5u tay n\xE0y th\u1EADt \u0111\xE1ng s\u1EE3"
  - key: khanlaudautay_h
    en: Pull the towel hanging on the cabinet to the window with fingerprints on
      it
    vn: "K\xE9o kh\u0103n treo tr\xEAn t\u1EE7 v\xE0o c\u1EEDa s\u1ED5 d\xEDnh d\u1EA5u
      tay"
  - key: khanlaudauchan_s
    en: Wipe away the mysterious footprints
    vn: "Lau m\u1EA5y c\xE1i d\u1EA5u ch\xE2n kh\xF4ng r\xF5 t\u1EEB \u0111\xE2u
      ra"
  - key: khanlaudauchan_h
    en: Drag the towel into the footprints on the floor
    vn: "K\xE9o kh\u0103n lau v\xE0o d\u1EA5u ch\xE2n tr\xEAn s\xE0n"
  - key: bangkeo_s
    en: It was as if something was locked inside
    vn: "C\u1EE9 nh\u01B0 th\u1EC3 c\xF3 th\u1EE9 g\xEC b\u1ECB nh\u1ED1t b\xEAn
      trong v\u1EADy"
  - key: bangkeo_h
    en: Pull the tape onto the pink cabinet
    vn: "K\xE9o cu\u1ED9n b\u0103ng keo v\xE0o t\u1EE7 h\u1ED3ng"
  - key: win2_s
    en: The next morning...
    vn: "S\xE1ng h\xF4m sau..."
  - key: men_s
    en: Pulling the blanket up feels safer
    vn: "\u0110\u1EAFp ch\u0103n l\u1EA1i c\u1EA3m gi\xE1c an to\xE0n h\u01A1n"
  - key: men_h
    en: Tap on the blanket on the bed
    vn: "B\u1EA5m v\xE0o c\xE1i m\u1EC1n tr\xEAn gi\u01B0\u1EDDng"
  - key: banpc_h
    en: Tap on the computer desk drawer
    vn: "B\u1EA5m v\xE0o h\u1ED9c t\u1EE7 c\u1EE7a b\xE0n m\xE1y t\xEDnh"
  - key: daydien_s
    en: Just unplug it
    vn: "Ch\u1EC9 c\u1EA7n r\xFAt \u0111i\u1EC7n ra l\xE0 \u0111\u01B0\u1EE3c"
  - key: daydien_h
    en: Tap on the power cord of the computer set
    vn: "B\u1EA5m v\xE0o d\xE2y \u0111i\u1EC7n c\u1EE7a b\u1ED9 m\xE1y t\xEDnh"
