MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 364864255}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv9
  title: titlelv9
  description: deslv9
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 519420031}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: cay
    stateId: cayDrag
    target: {fileID: 0}
  - type: 0
    targetId: damMay
    stateId: damMayDrag
    target: {fileID: 0}
  - type: 0
    targetId: listcogai
    stateId: coGaiZenBienHieu
    target: {fileID: 0}
  - type: 0
    targetId: listcogai
    stateId: coGaiThungRac
    target: {fileID: 0}
  - type: 0
    targetId: listcogai
    stateId: coGaiBang
    target: {fileID: 0}
  - type: 0
    targetId: listcogai
    stateId: coGaiTraiCheO
    target: {fileID: 0}
  - type: 0
    targetId: listcogai
    stateId: coGaiTaxi
    target: {fileID: 0}
  - type: 0
    targetId: listcogai
    stateId: coGaiGach
    target: {fileID: 0}
  - type: 0
    targetId: cuaSo
    stateId: cuaSoBienMat
    target: {fileID: 0}
  - type: 0
    targetId: listcogai
    stateId: coGaiAoKhoac
    target: {fileID: 0}
  - type: 0
    targetId: listcogai
    stateId: coGaiODu
    target: {fileID: 0}
  - type: 0
    targetId: listcogai
    stateId: coGaiLaCay
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: keo
    stateId: keoTuongTac
    target: {fileID: 0}
  timeLimit: 180
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: titlelv9
    en: Rain crossing.
    vn: "V\u01B0\u1EE3t m\u01B0a."
  - key: deslv9
    en: Can't let them get wet.
    vn: "Kh\xF4ng th\u1EC3 \u0111\u1EC3 h\u1ECD b\u1ECB \u01B0\u1EDBt \u0111\u01B0\u1EE3c."
  - key: zen1Success
    en: This University sign is big and can block the rain.
    vn: "Bi\u1EC3n b\xE1o \u0110\u1EA1i h\u1ECDc n\xE0y to, c\xF3 th\u1EC3 che m\u01B0a
      \u0111\u1EA5y."
  - key: taxiNumber
    en: Let's try to call a taxi.
    vn: "Th\u1EED g\u1ECDi taxi xem sao."
  - key: damMaySuccess
    en: With this amount of nutrients, young plants grow quickly.
    vn: "V\u1EDBi l\u01B0\u1EE3ng dinh d\u01B0\u1EE1ng n\xE0y, c\xE2y non mau ch\xF3ng
      l\u1EDBn."
  - key: thungRac1Success
    en: The smell is also quite fragrant and can also protect from the rain.
    vn: "M\xF9i c\u0169ng kh\xE1 th\u01A1m v\xE0 c\xF2n c\xF3 th\u1EC3 che m\u01B0a
      n\u1EEFa."
  - key: cay1Success
    en: Leave the small tree here and give it some water. But the tree grows a bit
      slowly.
    vn: "\u0110\u1EC3 c\xE2y nh\u1ECF ra \u0111\xE2y cho n\xF3 ch\xFAt n\u01B0\u1EDBc.
      Nh\u01B0ng c\xE2y l\u1EDBn h\u01A1i ch\u1EADm."
  - key: o1Success
    en: This umbrella can also cover the rain.
    vn: "Chi\u1EBFc d\xF9 n\xE0y c\u0169ng c\xF3 th\u1EC3 che m\u01B0a."
  - key: keoFail
    en: Why did you cut yourself off from the rain like this?
    vn: "Sao l\u1EA1i t\u1EF1 c\u1EAFt ch\u1ED7 tr\xFA m\u01B0a th\u1EBF n\xE0y."
  - key: laCayDragSuccess
    en: Such large leaves can also block the rain.
    vn: "L\xE1 c\xE2y l\u1EDBn nh\u01B0 v\u1EADy c\u0169ng  c\xF3 th\u1EC3 che m\u01B0a."
  - key: cuaSoSuccess
    en: The teacher is focusing on teaching.
    vn: "Th\u1EA7y gi\xE1o \u0111ang t\u1EADp trung d\u1EA1y h\u1ECDc."
  - key: TraiDragSuccess
    en: Call the bodyguards to come pick you up.
    vn: "G\u1ECDi c\u1EA3 v\u1EC7 s\u0129 \u0111\u1EBFn \u0111\xF3n lu\xF4n."
  - key: ganh2Success
    en: Need replace the tiles, someone might fall cause of it.
    vn: "Thay g\u1EA1ch m\u1EDBi th\xF4i, \u0111\u1EC3 v\u1EADy c\xF3 ng\u01B0\u1EDDi
      s\u1EBD ng\xE3 m\u1EA5t."
  - key: bang1Success
    en: The school's information board can also be used to protect from the rain!
    vn: "B\u1EA3ng th\xF4ng tin c\u1EE7a nh\xE0 tr\u01B0\u1EDDng c\u0169ng d\xF9ng
      \u0111\u1EC3 che m\u01B0a \u0111\u01B0\u1EE3c \u0111\xF3!"
  - key: gach1Success
    en: The brick can be used as a rain cover.
    vn: "Vi\xEAn g\u1EA1ch c\u0169ng c\xF3 th\u1EC3 d\xF9ng che m\u01B0a"
  - key: coGaiTaxiBienMatSuccess
    en: Let's go, the taxi has arrived.
    vn: "\u0110i th\xF4i, taxi d\u1EBFn r\u1ED3i."
  - key: remSuccess
    en: This big curtain protects you from the rain.
    vn: "R\xE8m to n\xE0y che m\u01B0a th\xEC kh\u1ECFi b\xE0n."
  - key: xaBengHint
    en: Drag the crowbar to the open brick on the road
    vn: "K\xE9o x\xE0 beng v\xE0o vi\xEAn g\u1EA1ch tr\xEAn h\u1EDF tr\xEAn \u0111\u01B0\u1EDDng"
  - key: BienHieuHint
    en: Drag the school name sign onto the girl
    vn: "K\xE9o bi\u1EC3n t\xEAn tr\u01B0\u1EDDng v\xE0o c\xF4 g\xE1i"
  - key: ThungRacHint
    en: Pull the trash can on the girl
    vn: "K\xE9o th\xF9ng r\xE1c v\xE0o c\xF4 g\xE1i"
  - key: BangHieuHint
    en: Drag the field notification in
    vn: "K\xE9o th\xF4ng b\xE1o tr\u01B0\u1EDDng v\xE0o"
  - key: GachHint
    en: Drag the brick
    vn: "K\xE9o vi\xEAn g\u1EA1ch"
  - key: LaCayHint
    en: Pull the leaves onto the girl
    vn: "K\xE9o l\xE1 c\xE2y v\xE0o c\xF4 g\xE1i"
  - key: ODuHint
    en: Pull the umbrella on the girl
    vn: "K\xE9o chi\u1EBFc \xF4 v\xE0o c\xF4 g\xE1i"
  - key: TraiCheOHint
    en: Pull the boy into the girl
    vn: "K\xE9o ch\xE0ng trai v\xE0o c\xF4 g\xE1i"
  - key: AoKhoacHint
    en: Pulled the jacket of the teacher who was teaching at the girl
    vn: "K\xE9o \xE1o kho\xE1c c\u1EE7a th\u1EA7y \u0111ang d\u1EA1y h\u1ECDc v\xE0o
      c\xF4 g\xE1i"
  - key: RemHint
    en: Pull the curtain on the girl
    vn: "K\xE9o t\u1EA5m r\xE8m v\xE0o c\xF4 g\xE1i"
  - key: TaxiHint
    en: Drag the phone number to the girl
    vn: "K\xE9o s\u1ED1 \u0111i\u1EC7n tho\u1EA1i v\xE0o c\xF4 g\xE1i"
  - key: cuSoHint
    en: Tap on the window on the porch.
    vn: "B\u1EA5m v\xE0o c\u1EEDa s\u1ED5 tr\xEAn m\xE1i hi\xEAn."
  - key: cayHint
    en: Drag the plant pot into the exposed brick
    vn: "K\xE9o ch\u1EADu c\xE2y v\xE0o ch\u1ED7 vi\xEAn g\u1EA1ch h\u1EDF"
  - key: keoFailHint
    en: Don't use scissors
    vn: "\u0110\u1EEBng s\u1EED d\u1EE5ng c\xE2y k\xE9o"
  - key: damMayHint
    en: Drag the cloud into the potted plant
    vn: "K\xE9o \u0111\xE1m m\xE2y v\xE0o ch\u1EADu c\xE2y"
