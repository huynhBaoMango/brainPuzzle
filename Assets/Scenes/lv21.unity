MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2127511940}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv21
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: cogai
    stateId: batden
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: manhinh
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: danlen
    target: {fileID: 0}
  - type: 0
    targetId: bo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: xalach
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: dau
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: antraicay
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: bitmat
    target: {fileID: 0}
  - type: 0
    targetId: tv
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: tongtai
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: meo
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: cuaso
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: matxa
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: matxa
    target: {fileID: 0}
  loseConditions: []
  timeLimit: 0
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Eye relaxation
    vn: "Th\u01B0 gi\xE3n m\u1EAFt"
  - key: des
    en: Help the girl relax her eyes
    vn: "Gi\xFAp c\xF4 g\xE1i th\u01B0 gi\xE3n \u0111\xF4i m\u1EAFt c\u1EE7a m\xECnh"
  - key: batden_s
    en: Looking in the dark will hurt your eyes, turn on the light
    vn: "Nh\xECn trong b\xF3ng t\u1ED1i s\u1EBD l\xE0m m\u1EAFt b\u1ECB \u0111au,
      m\u1EDF \u0111\xE8n l\xEAn"
  - key: batden_h
    en: Tap on the wall switch to turn on the light
    vn: "B\u1EA5m v\xE0o c\xF4ng t\u1EAFc tr\xEAn t\u01B0\u1EDDng \u0111\u1EC3 m\u1EDF
      \u0111\xE8n"
  - key: manhinh_s
    en: Looking at the screen for a long time makes my eyes tired, so turn it off
    vn: "Nh\xECn m\xE0n h\xECnh trong th\u1EDDi gian d\xE0i l\xE0m t\xF4i m\u1ECFi
      m\u1EAFt, t\u1EAFt n\xF3 th\xF4i"
  - key: manhinh_h
    en: Tap on the computer screen
    vn: "B\u1EA5m v\xE0o m\xE0n h\xECnh m\xE1y t\xEDnh"
  - key: danlen_s
    en: Knitting relaxes both the eyes and the mind
    vn: "\u0110an len \u0111\u1EC3 th\u01B0 gi\xE3n c\u1EA3 m\u1EAFt v\xE0 tinh th\u1EA7n"
  - key: danlen_h
    en: Pull the ball of wool on the TV cabinet at the girl
    vn: "K\xE9o c\u1EE5c len tr\xEAn t\u1EE7 tivi v\xE0o c\xF4 g\xE1i"
  - key: antraicay_s
    en: Eat fruit salad that is good for your eyes
    vn: "\u0102n salad tr\xE1i c\xE2y b\u1ED5 cho m\u1EAFt"
  - key: antraicay_h
    en: Drag the fruit bowl to the girl
    vn: "K\xE9o t\xF4 tr\xE1i c\xE2y v\xE0o c\xF4 g\xE1i"
  - key: bitmat_s
    en: Wear a eye mask and relax for a while
    vn: "\u0110eo b\u1ECBt m\u1EAFt th\u01B0 gi\xE3n m\u1ED9t l\xFAc"
  - key: bitmat_h
    en: Drag the eye mask on the girl
    vn: "K\xE9o b\u1ECBt m\u1EAFt v\xE0o c\xF4 g\xE1i"
  - key: tongtai_s
    en: This is pleasing to the eye, in a different way
    vn: "\u0110\xE2y c\u0169ng l\xE0 b\u1ED5 m\u1EAFt theo m\u1ED9t c\xE1ch kh\xE1c"
  - key: tongtai_h
    en: Drag the man from the TV onto the girl
    vn: "K\xE9o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng trong tivi v\xE0o c\xF4 g\xE1i"
  - key: meo_s
    en: Play with the cat to rest my eyes
    vn: "Ch\u01A1i v\u1EDBi m\xE8o m\u1ED9t l\xFAc \u0111\u1EC3 th\u01B0 gi\xE3n
      m\u1EAFt"
  - key: meo_h
    en: Tap on the cat
    vn: "B\u1EA5m v\xE0o con m\xE8o"
  - key: cuaso_s
    en: Get some sunlight to relax
    vn: "\u0110\xF3n n\u1EAFng \u0111\u1EC3 th\u01B0 gi\xE3n"
  - key: cuaso_h
    en: Tap on the window
    vn: "B\u1EA5m v\xE0o c\u1EEDa s\u1ED5"
  - key: matxa_s
    en: Self-massage is also very relaxing
    vn: "T\u1EF1 m\xE1t xa c\u0169ng r\u1EA5t th\u01B0 gi\xE3n"
  - key: matxa_h
    en: Tap on the girl's eyes
    vn: "B\u1EA5m v\xE0o m\u1EAFt c\u1EE7a c\xF4 g\xE1i"
  - key: met_s
    en: Relaxed a bit, but still tired
    vn: "Th\u01B0 gi\xE3n \u0111\u01B0\u1EE3c m\u1ED9t \xEDt, nh\u01B0ng v\u1EABn
      c\xF2n m\u1EC7t"
  - key: bo_h
    en: Drag the avocado from the cat bowl to the bowl on the table
    vn: "K\xE9o tr\xE1i b\u01A1 trong b\xE1t m\xE8o v\xE0o t\xF4 tr\xEAn b\xE0n"
  - key: dau_h
    en: Drag the strawberry in the picture on the wall into the bowl on the table
    vn: "K\xE9o tr\xE1i d\xE2u trong tranh tr\xEAn t\u01B0\u1EDDng v\xE0o t\xF4 tr\xEAn
      b\xE0n"
  - key: xalach_h
    en: Drag the lettuce from the window into the bowl on the table
    vn: "K\xE9o rau x\xE0 l\xE1ch tr\xEAn c\u1EEDa s\u1ED5 v\xE0o t\xF4 tr\xEAn b\xE0n"
  - key: tv_h
    en: Tap on TV
    vn: "B\u1EA5m v\xE0o tivi"
