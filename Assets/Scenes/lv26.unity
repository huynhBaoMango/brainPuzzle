  - type: 0
    targetId: mangnhen
    stateId: used_ca
    target: {fileID: 0}
  - type: 0
    targetId: ca
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: mangnhen
    stateId: used_ngheu
    target: {fileID: 0}
  - type: 0
    targetId: ngheu
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: rongbien1
