  loseConditions:
  - type: 0
    targetId: nam
    stateId: used
    target: {fileID: 0}
  timeLimit: 180
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Barbecue
    vn: "\u0110\u1ED3 n\u01B0\u1EDBng"
  - key: des
    en: Make a delicious grilled meal
    vn: "L\xE0m ra m\u1ED9t b\u1EEFa \u0111\u1ED3 n\u01B0\u1EDBng th\u1EADt ngon"
  - key: mangnhen_s
    en: Use spider webs as fishing nets
    vn: "D\xF9ng m\u1EA1ng nh\u1EC7n l\xE0m l\u01B0\u1EDBi \u0111\xE1nh b\u1EAFt"
  - key: mangnhen_h
    en: Pulling the spider web out to sea
    vn: "K\xE9o m\u1EA1ng nh\u1EC7n ra bi\u1EC3n"
  - key: mangnhen2_s
    en: Use spider webs as fishing nets
    vn: "D\xF9ng m\u1EA1ng nh\u1EC7n l\xE0m l\u01B0\u1EDBi \u0111\xE1nh b\u1EAFt"
  - key: mangnhen2_h
    en: Pulling the spider web out to sea
    vn: "K\xE9o m\u1EA1ng nh\u1EC7n ra bi\u1EC3n"
  - key: nam_lose_s
    en: This mushroom is poisonous!
    vn: "N\u1EA5m n\xE0y c\xF3 \u0111\u1ED9c!"
  - key: nam_lose_h
    en: Don't use mushrooms
    vn: "\u0110\u1EEBng s\u1EED d\u1EE5ng n\u1EA5m"
  - key: keo_h
    en: Pull the scissors buried in the sand at the girl behind
    vn: "K\xE9o c\xE2y k\xE9o v\xF9i d\u01B0\u1EDBi c\xE1t v\xE0o c\xF4 g\xE1i \u0111\u1EB1ng
      sau"
  - key: toc_s
    en: Ask this beautiful lady for some noodles
    vn: "Xin m\u1EF9 n\u1EEF m\u1ED9t \xEDt m\xEC"
  - key: toc_h
    en: Pull hair into the grill
    vn: "K\xE9o t\xF3c v\xE0o b\u1EBFp n\u01B0\u1EDBng"
  - key: ngheu_s
    en: Grilled clams are excellent
    vn: "Ngh\xEAu n\u01B0\u1EDBng l\xE0 tuy\u1EC7t v\u1EDDi"
  - key: ngheu_h
    en: Pull the clams on the net into the grill
    vn: "K\xE9o ngh\xEAu tr\xEAn l\u01B0\u1EDBi v\xE0o b\u1EBFp n\u01B0\u1EDBng"
  - key: dua_s
    en: A really sweet coconut!
    vn: "M\u1ED9t tr\xE1i d\u1EEBa th\u1EADt ng\u1ECDt!"
  - key: dua_h
    en: Pull the coconut from the tree into the grill
    vn: "K\xE9o tr\xE1i d\u1EEBa tr\xEAn c\xE2y v\xE0o b\u1EBFp n\u01B0\u1EDBng"
  - key: chim_s
    en: It smells like grilled chicken
    vn: "N\xF3 c\xF3 m\xF9i nh\u01B0 th\u1ECBt g\xE0 n\u01B0\u1EDBng"
  - key: chim_h
    en: Pull the bird from the tree into the grill
    vn: "K\xE9o chim tr\xEAn c\xE2y v\xE0o b\u1EBFp n\u01B0\u1EDBng"
  - key: ca_s
    en: Must have grilled fish
    vn: "Nh\u1EA5t \u0111\u1ECBnh ph\u1EA3i c\xF3 c\xE1 n\u01B0\u1EDBng!"
  - key: ca_h
    en: Drag the fish on the net into the grill
    vn: "K\xE9o c\xE1 tr\xEAn l\u01B0\u1EDBi v\xE0o b\u1EBFp n\u01B0\u1EDBng"
  - key: cua_s
    en: Grilled crab is the best seller for every seafood meal!
    vn: "Cua n\u01B0\u1EDBng l\xE0 best seller m\u1ECDi b\u1EEFa h\u1EA3i s\u1EA3n!"
  - key: cua_h
    en: Pull the crab into the grill
    vn: "K\xE9o cua v\xE0o b\u1EBFp n\u01B0\u1EDBng"
  - key: rongbien_s
    en: Grilled seaweed for a plant-based dish!
    vn: "Rong bi\u1EC3n n\u01B0\u1EDBng cho c\xF3 m\xF3n th\u1EF1c v\u1EADt! "
  - key: rongbien_h
    en: Drag the seaweed in the net into the grill
    vn: "K\xE9o rong bi\u1EC3n trong l\u01B0\u1EDBi v\xE0o b\u1EBFp n\u01B0\u1EDBng"
  - key: nhen_s
    en: Grilled spider is quite a strange dish to many people, right?
    vn: "Nh\u1EC7n n\u01B0\u1EDBng l\xE0 m\xF3n kh\xE1 l\u1EA1 v\u1EDBi nhi\u1EC1u
      ng\u01B0\u1EDDi, nh\u1EC9?"
  - key: nhen_h
    en: Drag the spider to the grill
    vn: "K\xE9o nh\u1EC7n v\xE0o b\u1EBFp n\u01B0\u1EDBng"
  - key: ot_s
    en: Spicy but very delicious!
    vn: "Cay nh\u01B0ng r\u1EA5t cu\u1ED1n!"
  - key: ot_h
    en: Pull the peppers on the poster into the grill
    vn: "K\xE9o \u1EDBt tr\xEAn poster v\xE0o b\u1EBFp n\u01B0\u1EDBng"
  - key: xeng_h
    en: Drag the shovel into the sand pit
    vn: "K\xE9o x\u1EBBng v\xE0o h\u1ED1 c\xE1t"
  - key: tom_s
    en: This shrimp has a lot of meat
    vn: "Con t\xF4m n\xE0y nhi\u1EC1u th\u1ECBt ph\u1EBFt"
  - key: tom_h
    en: Pull the shrimp into the grill
    vn: "K\xE9o t\xF4m v\xE0o b\u1EBFp n\u01B0\u1EDBng"
