  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv41
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: bachtuoc1
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: maybay
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: xuongrong
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: odien
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: dt
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: mubaohiem
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: ga
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: shit
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cauvong
    stateId: used
    target: {fileID: 0}
  loseConditions: []
  timeLimit: 180
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Hair salon
    vn: "Ti\u1EC7m t\xF3c"
  - key: des
    en: Help customers get their favorite hairstyle
    vn: "Gi\xFAp c\xE1c kh\xE1ch h\xE0ng c\xF3 \u0111\u01B0\u1EE3c ki\u1EC3u t\xF3c
      h\u1ECD \u01B0a th\xEDch"
  - key: shit_h
    en: Drag the dog poop onto the girl
    vn: "K\xE9o ph\xE2n ch\xF3 v\xE0o c\xF4 g\xE1i"
  - key: maybay_h
    en: Drag the airplane onto the girl
    vn: "K\xE9o m\xE1y bay v\xE0o c\xF4 g\xE1i"
  - key: odien_h
    en: Drag the power outlet onto the girl
    vn: "K\xE9o \u1ED5 \u0111i\u1EC7n v\xE0o c\xF4 g\xE1i"
  - key: dt_h
    en: Tap the phone
    vn: "B\u1EA5m v\xE0o \u0111i\u1EC7n tho\u1EA1i"
  - key: ga_h
    en: Pull the chicken piece from the shipper's hand onto the dog
    vn: "K\xE9o mi\u1EBFng g\xE0 tr\xEAn tay shipper v\xE0o con ch\xF3"
  - key: bachtuoc_s
    en: Behold, the octopus look!
    vn: "\u0110\xE2y l\xE0 ki\u1EC3u b\u1EA1ch tu\u1ED9c, \u0111\u1ED9c \u0111\xE1o
      ph\u1EA3i kh\xF4ng?"
  - key: maybay_s
    en: Here comes the airplane hairstyle
    vn: "Ki\u1EC3u t\xF3c m\xE1y bay t\u1EDBi \u0111\xE2y"
  - key: xuongrong_s
    en: Spiky cactus, very edgy
    vn: "Gai gai x\u01B0\u01A1ng r\u1ED3ng, ng\u1EA7u ch\u01B0a!"
  - key: dien_s
    en: Shock therapy, hair-style edition!
    vn: "Li\u1EC7u ph\xE1p \u0111i\u1EC7n gi\u1EADt, m\u1EDBi m\u1EBB l\u1EAFm!"
  - key: baohiem_s
    en: No need to wear a helmet anymore
    vn: "Kh\xF4ng c\u1EA7n \u0111\u1ED9i m\u0169 b\u1EA3o hi\u1EC3m n\u1EEFa lu\xF4n"
  - key: shit_s
    en: Don't worry, this stuff is completely odorless. Really.
    vn: "Y\xEAn t\xE2m nh\xE9, th\u1EE9 n\xE0y kh\xF4ng c\xF3 m\xF9i \u0111\xE2u..."
  - key: cauvong_s
    en: Seven colors, a masterpiece!
    vn: "B\u1EA3y s\u1EAFc c\u1EA7u v\u1ED3ng, ki\u1EC7t t\xE1c!"
  - key: xuongrong_h
    en: Drag the cactus onto the girl
    vn: "K\xE9o x\u01B0\u01A1ng r\u1ED3ng v\xE0o c\xF4 g\xE1i"
  - key: cauvong_h
    en: Drag the rainbow onto the girl
    vn: "K\xE9o c\u1EA7u v\u1ED3ng v\xE0o c\xF4 g\xE1i"
  - key: mubaohiem_h
    en: Drag the shipper's helmet onto the girl
    vn: "K\xE9o m\u0169 b\u1EA3o hi\u1EC3m c\u1EE7a shipper v\xE0o c\xF4 g\xE1i"
  - key: bachtuoc_h
    en: Drag the octopus onto the girl
    vn: "K\xE9o b\u1EA1ch tu\u1ED9c v\xE0o c\xF4 g\xE1i"
