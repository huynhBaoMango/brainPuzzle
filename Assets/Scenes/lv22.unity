  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv22
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: meo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cavat
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: dayleo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cua
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: duoisoc
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: lynuoc
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: ruybang
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: quasoi
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: hun
    target: {fileID: 0}
  - type: 0
    targetId: thanh
    stateId: state4
    target: {fileID: 0}
  loseConditions: []
  timeLimit: 150
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Love confession
    vn: "T\u1ECF t\xECnh"
  - key: des
    en: Help the guy confess his love smoothly
    vn: "Gi\xFAp ch\xE0ng trai t\u1ECF t\xECnh m\u1ED9t c\xE1ch su\xF4n s\u1EBB"
  - key: hoa_s
    en: A bouquet can say a thousand words
    vn: "M\u1ED9t b\xF3 hoa c\xF3 th\u1EC3 n\xF3i thay ng\xE0n l\u1EDDi"
  - key: hoa_h
    en: Drag flowers on the girl
    vn: "K\xE9o hoa v\xE0o c\xF4 g\xE1i"
  - key: lynuoc_h
    en: Drag the indoor water cup into the plant pot
    vn: "K\xE9o ly n\u01B0\u1EDBc trong nh\xE0 v\xE0o ch\u1EADu c\xE2y"
  - key: hun_s
    en: A kiss is the final piece
    vn: "N\u1EE5 h\xF4n s\u1EBD l\xE0 m\u1EA3nh gh\xE9p cu\u1ED1i c\xF9ng"
  - key: hun_h
    en: Tap on the girl's face
    vn: "B\u1EA5m v\xE0o m\u1EB7t c\xF4 g\xE1i"
  - key: duoisoc_s
    en: Squirrel tails are used to make cello strings
    vn: "\u0110u\xF4i s\xF3c d\xF9ng l\xE0m d\xE2y \u0111\xE0n cello lu\xF4n"
  - key: duoisoc_h
    en: Pull the squirrel's tail onto the cello
    vn: "K\xE9o \u0111u\xF4i con s\xF3c v\xE0o c\xE2y \u0111\xE0n cello"
  - key: meo_s
    en: Use cat whiskers to make cello strings
    vn: "T\u1EADn d\u1EE5ng r\xE2u m\xE8o l\xE0m d\xE2y \u0111\xE0n cello"
  - key: meo_h
    en: Drag the cat to the cello
    vn: "K\xE9o con m\xE8o v\xE0o c\xE2y \u0111\xE0n cello"
  - key: cavat_s
    en: Sacrifice my expensive tie
    vn: "Hi sinh lu\xF4n chi\u1EBFc c\xE0 v\u1EA1t \u0111\u1EAFt ti\u1EC1n"
  - key: cavat_h
    en: Drag the man's tie to the cello
    vn: "K\xE9o c\xE0 v\u1EA1 tr\xEAn ng\u01B0\u1EDDi \u0111\xE0n \xF4ng v\xE0o c\xE2y
      \u0111\xE0n cello"
  - key: la_s
    en: Borrow this vine as a cello string
    vn: "M\u01B0\u1EE3n c\xE1i d\xE2y leo n\xE0y l\xE0m d\xE2y \u0111\xE0n cello"
  - key: la_h
    en: Drag the vines from the tree onto the cello
    vn: "K\xE9o d\xE2y leo tr\xEAn c\xE2y v\xE0o c\xE2y \u0111\xE0n cello"
