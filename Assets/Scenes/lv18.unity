  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv18
  title: title
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: balo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: capinside
    stateId: open
    target: {fileID: 0}
  - type: 0
    targetId: tuavit
    stateId: banhxe
    target: {fileID: 0}
  - type: 0
    targetId: tuavit
    stateId: chuot
    target: {fileID: 0}
  - type: 0
    targetId: cua
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: tien
    stateId: tien
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: capinside
    stateId: open_lose
    target: {fileID: 0}
  timeLimit: 0
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: title
    en: Cable car
    vn: "C\xE1p treo"
  - key: des
    en: Rescue everyone trapped in the cable car accident!
    vn: "Gi\u1EA3i c\u1EE9u m\u1ECDi ng\u01B0\u1EDDi kh\u1ECFi s\u1EF1 c\u1ED1 c\xE1p
      treo!"
  - key: tien_s
    en: Use money to repair broken glass
    vn: "D\xF9ng ti\u1EC1n s\u1EEDa l\u1EA1i k\xEDnh v\u1EE1"
  - key: tien_h
    en: Drag the money to the broken glass window
    vn: "K\xE9o ti\u1EC1n v\xE0o ph\u1EA7n c\u1EEDa k\xEDnh v\u1EE1"
  - key: cua_lose_h
    en: Don't open the door before the girl leaves safely
    vn: "\u0110\u1EEBng m\u1EDF c\u1EEDa tr\u01B0\u1EDBc khi c\xF4 g\xE1i r\u1EDDi
      kh\u1ECFi \u0111\xF3 an to\xE0n"
  - key: cua_s
    en: 
    vn: 
  - key: cua_h
    en: Tap on the part below the glass to open the cable compartment
    vn: "B\u1EA5m v\xE0o ph\u1EA7n b\xEAn d\u01B0\u1EDBi k\xEDnh \u0111\u1EC3 m\u1EDF
      h\u1ED9c c\xE1p treo"
  - key: hoctu_h
    en: Tap on the small cabinet above the two boys' heads
    vn: "B\u1EA5m v\xE0o t\u1EE7 nh\u1ECF ph\xEDa tr\xEAn \u0111\u1EA7u 2 c\u1EADu
      b\xE9"
  - key: cogai_s
    en: Goodbye, I'm leaving now!
    vn: "T\u1EA1m bi\u1EC7t, t\xF4i \u0111i tr\u01B0\u1EDBc \u0111\xE2y!"
  - key: tuavit_banhxe_s
    en: Tighten the wheel so it doesn't slip anymore
    vn: "Si\u1EBFt b\xE1nh xe l\u1EA1i cho n\xF3 kh\xF4ng tr\u01B0\u1EE3t n\u1EEFa"
  - key: tuavit_banhxe_h
    en: Drag the screwdriver on the compartment door onto the gear wheel
    vn: "K\xE9o tua v\xEDt tr\xEAn c\u1EEDa h\u1ED9c v\xE0o b\xE1nh xe c\u1EE7a b\xE1nh
      r\u0103ng "
  - key: tuavit_chuot_s
    en: This mouse is jamming the machine, sorry
    vn: "Con chu\u1ED9t n\xE0y \u0111ang l\xE0m k\u1EB9t m\xE1y, xin l\u1ED7i nh\xE9"
  - key: tuavit_chuot_h
    en: Drag the screwdriver on the drawer door onto the mouse
    vn: "K\xE9o tua v\xEDt tr\xEAn c\u1EEDa h\u1ED9c v\xE0o con chu\u1ED9t"
  - key: balo_s
    en: 
    vn: 
  - key: balo_h
    en: Drag the blue backpack from the side window for the girl
    vn: "K\xE9o ba l\xF4 m\xE0u xanh \u1EDF c\u1EEDa k\xEDnh b\xEAn h\xF4ng cho c\xF4
      g\xE1i"
