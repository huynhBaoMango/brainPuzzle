--- !u!114 &1166026277
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1166026276}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv20
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: cam
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: chainuoc
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cua
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: chim
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cuatu
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: maysay
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: binhxitcon
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: keo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: nam8
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: couple
    stateId: win
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: couple
    stateId: lose_day
    target: {fileID: 0}
  - type: 0
    targetId: couple
    stateId: lose_bang
    target: {fileID: 0}
  timeLimit: 120
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Stuck together
    vn: "D\xEDnh v\xE0o nhau"
  - key: des
    en: Find a way to separate them
    vn: "T\xECm c\xE1ch \u0111\u1EC3 g\u1EE1 h\u1ECD ra kh\u1ECFi nhau"
  - key: lose_bang_s
    en: It's hopeless!
    vn: "H\u1EBFt c\u1EE9u!"
  - key: lose_bang_h
    en: Don't drag ice posters on them
    vn: "\u0110\u1EEBng k\xE9o poster b\u0103ng v\xE0o h\u1ECD"
  - key: lose_day_s
    en: Now they're stuck even tighter!
    vn: "Sao l\u1EA1i c\xF2n tr\xF3i ch\u1EB7t th\xEAm ch\u1EE9!"
  - key: lose_day_h
    en: Don't drag the rope on them
    vn: "\u0110\u1EEBng k\xE9o d\xE2y th\u1EEBng v\xE0o h\u1ECD"
  - key: ao_s
    en: Borrow some sweat from the muscle guy
    vn: "M\u01B0\u1EE3n m\u1ED9t \xEDt m\u1ED3 h\xF4i c\u1EE7a anh trai c\u01A1 b\u1EAFp"
  - key: ao_h
    en: Drag the man behind them into them
    vn: "K\xE9o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng ph\xEDa sau v\xE0o h\u1ECD"
  - key: chim_s
    en: (Let me help)
    vn: "(\u0110\u1EC3 ta gi\xFAp m\u1ED9t tay)"
  - key: chim_h
    en: Drag the bird into them
    vn: "K\xE9o con chim v\xE0o h\u1ECD"
  - key: keo_s
    en: 
    vn: 
  - key: keo_h
    en: Drag the scissors lying on the floor at them
    vn: "K\xE9o c\xE1i k\xE9o n\u1EB1m tr\xEAn s\xE0n v\xE0o h\u1ECD"
  - key: cam_s
    en: Orange juice would probably help
    vn: "N\u01B0\u1EDBc cam c\xF3 l\u1EBD s\u1EBD c\xF3 \xEDch"
  - key: cam_h
    en: Drag the orange on the fruit plate to them
    vn: "K\xE9o tr\xE1i cam tr\xEAn d\u0129a tr\xE1i c\xE2y v\xE0o h\u1ECD"
  - key: tu_h
    en: Tap on the cabinet in the right corner
    vn: "B\u1EA5m v\xE0o t\u1EE7 \u1EDF g\xF3c ph\u1EA3i"
  - key: cua_s
    en: Sunlight will melt the glue
    vn: "\xC1nh n\u1EAFng s\u1EBD l\xE0m tan ch\u1EA3y keo"
  - key: cua_h
    en: Tap on the glass door in the back
    vn: "B\u1EA5m v\xE0o c\u1EEDa k\xEDnh \u1EDF ph\xEDa sau"
  - key: chainuoc_s
    en: 
    vn: 
  - key: chainuoc_h
    en: Drag the water bottle at them
    vn: "K\xE9o chai n\u01B0\u1EDBc v\xE0o h\u1ECD"
  - key: maysay_s
    en: 
    vn: 
  - key: maysay_h
    en: Drag the dryer on them
    vn: "K\xE9o m\xE1y s\u1EA5y v\xE0o h\u1ECD"
  - key: binhxit_s
    en: Alcohol dissolves glue
    vn: "C\u1ED3n l\xE0m tan \u0111\u01B0\u1EE3c keo"
  - key: binhxit_h
    en: Drag the spray on them
    vn: "K\xE9o b\xECnh x\u1ECBt v\xE0o h\u1ECD"
  - key: intro
    en: Help, we're stuck together!
    vn: "C\u1EE9u v\u1EDBi, ch\xFAng t\xF4i b\u1ECB d\xEDnh v\xE0o nhau r\u1ED3i!"
  - key: win
    en: Finally, we're free!
    vn: "Cu\u1ED1i c\xF9ng c\u0169ng g\u1EE1 ra \u0111\u01B0\u1EE3c r\u1ED3i"
