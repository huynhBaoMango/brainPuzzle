  - type: 0
    targetId: tranhdighe
    stateId: used_lose
    target: {fileID: 0}
  timeLimit: 0
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Cinderella
    vn: "L\u1ECD lem"
  - key: des
    en: Help her dress up to attend the prince's party
    vn: "Gi\xFAp c\xF4 \u1EA5y \u0103n di\u1EC7n \u0111\u1EC3 \u0111\u01B0\u1EE3c
      d\u1EF1 ti\u1EC7c c\u1EE7a ho\xE0ng t\u1EED"
  - key: vay_s
    en: This dress is gorgeous!
    vn: "B\u1ED9 v\xE1y n\xE0y th\u1EADt l\u1ED9ng l\u1EABy!"
  - key: vay_h
    en: Drag the skirt on the girl
    vn: "K\xE9o v\xE1y v\xE0o c\xF4 g\xE1i"
  - key: nguago_h
    en: Drag the wooden horse outside the house
    vn: "K\xE9o ng\u1EF1a g\u1ED7 ra ngo\xE0i nh\xE0"
  - key: bingo_h
    en: Drag the pumpkin outside the house
    vn: "K\xE9o b\xED ng\xF4 ra ngo\xE0i nh\xE0"
  - key: goi_h
    en: Drag the pillow outside the house
    vn: "K\xE9o g\u1ED1i ra ngo\xE0i nh\xE0"
  - key: duaphepbinhhoa_s
    en: A bottle of perfume!
    vn: "M\u1ED9t l\u1ECD n\u01B0\u1EDBc hoa!"
  - key: duaphepbinhhoa_h
    en: Drag the stick into the flower pot next to it
    vn: "K\xE9o chi\u1EBFc g\u1EADy v\xE0o ch\u1EADu hoa k\u1EBF b\xEAn"
  - key: duaphepdam_s
    en: Turn into a dress!
    vn: "H\xE3y bi\u1EBFn th\xE0nh 1 chi\u1EBFc \u0111\u1EA7m!"
  - key: duaphepdam_h
    en: Drag the stick into the fabric and thread on the bed
    vn: "K\xE9o chi\u1EBFc g\u1EADy v\xE0o v\u1EA3i v\xE0 ch\u1EC9 tr\xEAn gi\u01B0\u1EDDng"
  - key: nuochoa_s
    en: No more unpleasant odors
    vn: "Kh\xF4ng c\xF2n m\xF9i h\xF4i kh\xF3 ch\u1ECBu n\u1EEFa"
  - key: nuochoa_h
    en: Drag the perfume on the girl
    vn: "K\xE9o n\u01B0\u1EDBc hoa v\xE0o c\xF4 g\xE1i"
  - key: tam_s
    en: Wait a minute, I'll go take a shower
    vn: "\u0110\u1EE3i m\u1ED9t ch\xFAt, t\xF4i s\u1EBD \u0111i t\u1EAFm"
  - key: tam_h
    en: Swipe the girl up to take a shower
    vn: "Vu\u1ED1t c\xF4 g\xE1i l\xEAn \u0111\u1EC3 \u0111i t\u1EAFm"
  - key: win
    en: I can go to the party now!
    vn: "Ta c\xF3 th\u1EC3 \u0111i d\u1EF1 ti\u1EC7c \u0111\u01B0\u1EE3c r\u1ED3i!"
  - key: hopgiay_s
    en: 
    vn: 
  - key: hopgiay_f
    en: There's no room!
    vn: "Kh\xF4ng c\xF3 ch\u1ED7 \u0111\u1EC3!"
  - key: hopgiay_h
    en: Tap on the pink box on the wall when the bed is empty
    vn: "B\u1EA5m v\xE0o h\u1ED9p m\xE0u h\u1ED3ng tr\xEAn t\u01B0\u1EDDng khi gi\u01B0\u1EDDng
      tr\u1ED1ng"
  - key: cuanhatam_h
    en: Tap on the door behind the girl
    vn: "B\u1EA5m v\xE0o c\u1EEDa \u0111\u1EB1ng sau c\xF4 g\xE1i"
  - key: bangdo_f
    en: Can't get my hair done yet
    vn: "Ch\u01B0a th\u1EC3 c\xE0i t\xF3c \u0111\u01B0\u1EE3c"
  - key: bangdo_h
    en: Drag the headband on the girl
    vn: "K\xE9o b\u0103ng \u0111\xF4 v\xE0o c\xF4 g\xE1i"
  - key: chi_h
    en: Drag the spool of thread into the fabric on the bed
    vn: "K\xE9o cu\u1ED9n ch\u1EC9 v\xE0o v\u1EA3i tr\xEAn gi\u01B0\u1EDDng"
  - key: vay_lose_s
    en: My dress is dirty!
    vn: "D\u01A1 b\u1ED9 v\xE1y c\u1EE7a ta r\u1ED3i!"
  - key: vay_lose_h
    en: Don't wear a new dress without showering
    vn: "\u0110\u1EEBng m\u1EB7c v\xE1y m\u1EDBi khi ch\u01B0a t\u1EAFm"
  - key: dighe_lose
    en: You can't go anywhere!
    vn: "Ng\u01B0\u01A1i kh\xF4ng \u0111\u01B0\u1EE3c \u0111i \u0111\xE2u h\u1EBFt!"
  - key: dighe_lose_h
    en: Don't touch the stepmother's painting on the wall
    vn: "\u0110\u1EEBng \u0111\u1ED9ng v\xE0o tranh d\xEC gh\u1EBB tr\xEAn t\u01B0\u1EDDng"
  - key: bangdo_s
    en: 
    vn: 
