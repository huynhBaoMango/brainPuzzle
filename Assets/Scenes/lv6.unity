  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv6
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: cuanhatam
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: lolem
    stateId: tam
    target: {fileID: 0}
  - type: 0
    targetId: gayphep
    stateId: used_binhhoa
    target: {fileID: 0}
  - type: 0
    targetId: nuochoa
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: chi
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: gayphep
    stateId: used_dam
    target: {fileID: 0}
  - type: 0
    targetId: vay
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: bangdo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: hopgiay
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: bingo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: nguago
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: goi
    stateId: used
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: vay
    stateId: used_lose
