--- !u!114 &1872992553
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1872992552}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv33
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: keo
    stateId: used_ghe
    target: {fileID: 0}
  - type: 0
    targetId: loxo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: dongho2
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: keo_ran
    stateId: used_ghe
    target: {fileID: 0}
  - type: 0
    targetId: caheo1
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: denpin
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: coson
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: thit
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: bom
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: khi
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: nhietke
    stateId: used
    target: {fileID: 0}
  loseConditions: []
  timeLimit: 0
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Zoo in chaos
    vn: "S\u1EDF th\xFA b\u1EA5t \u1ED5n"
  - key: des
    en: Return the animals to normal before opening time.
    vn: "\u0110\u01B0a c\xE1c con v\u1EADt tr\u1EDF l\u1EA1i b\xECnh th\u01B0\u1EDDng
      tr\u01B0\u1EDBc gi\u1EDD m\u1EDF c\u1EEDa"
  - key: tho_a
    en: Why is this rabbit walking?!
    vn: "T\u1EA1i sao con th\u1ECF n\xE0y l\u1EA1i \u0111i b\u1ED9?!"
  - key: bao_a
    en: This leopard is too slow!
    vn: "Con b\xE1o n\xE0y qu\xE1 ch\u1EADm r\u1ED3i!"
  - key: ran_a
    en: Why does this snake have legs??
    vn: "Con r\u1EAFn n\xE0y sao l\u1EA1i c\xF3 ch\xE2n??"
  - key: caheo_a
    en: Dolphins can't stay on shore like that!
    vn: "C\xE1 heo kh\xF4ng th\u1EC3 \u1EDF tr\xEAn b\u1EDD nh\u01B0 v\u1EADy \u0111\u01B0\u1EE3c!"
  - key: domdom_a
    en: This firefly does not glow
    vn: "\u0110om \u0111\xF3m n\xE0y ch\u1EB3ng ph\xE1t s\xE1ng"
  - key: gautruc_a
    en: The color of this panda is strange
    vn: "M\xE0u c\u1EE7a con g\u1EA5u tr\xFAc n\xE0y th\u1EADt k\xEC l\u1EA1"
  - key: sutu_a
    en: Lions are vegetarian??
    vn: "S\u01B0 t\u1EED \u0103n chay??"
  - key: dadieu_a
    en: This ostrich has such a short neck!
    vn: "Con \u0111\xE0 \u0111i\u1EC3u n\xE0y c\u1ED5 ng\u1EAFn v\u1EADy!"
  - key: khi_a
    en: Monkeys should not be in the water!
    vn: "Kh\u1EC9 kh\xF4ng n\xEAn \u1EDF d\u01B0\u1EDBi n\u01B0\u1EDBc!"
  - key: rua_a
    en: Why isn't the turtle in its shell?!
    vn: "Sao con r\xF9a kh\xF4ng \u1EDF trong mai c\u1EE7a n\xF3?!"
  - key: coson_s
    en: Return the panda to its correct color
    vn: "\u0110\u01B0a con g\u1EA5u tr\xFAc v\u1EC1 \u0111\xFAng m\xE0u c\u1EE7a
      n\xF3"
  - key: coson_h
    en: Drag the paintbrush onto the panda
    vn: "K\xE9o c\u1ECD s\u01A1n v\xE0o con g\u1EA5u tr\xFAc"
  - key: dongho_s
    en: "Speed \u200B\u200Bup the cheetah"
    vn: "T\u0103ng t\u1ED1c con b\xE1o l\xEAn"
  - key: dongho_h
    en: Drag the watch on the girl's hand to the leopard
    vn: "K\xE9o \u0111\u1ED3ng h\u1ED3 tr\xEAn tay c\xF4 g\xE1i v\xE0o con b\xE1o"
  - key: nhietke_s
    en: Reduce the temperature so it's no longer hot
    vn: "Gi\u1EA3m nhi\u1EC7t \u0111\u1ED9 \u0111\u1EC3 kh\xF4ng c\xF2n n\xF3ng n\u1EEFa"
  - key: nhietke_h
    en: Pull the thermometer behind the girl onto the turtle
    vn: "K\xE9o c\xE1i nhi\u1EC7t k\u1EBF ph\xEDa sau c\xF4 g\xE1i v\xE0o con r\xF9a"
  - key: keoran_s
    en: Cut off its legs
    vn: "C\u1EAFt b\u1EDBt m\u1EA5y c\xE1i ch\xE2n c\u1EE7a n\xF3 \u0111i"
  - key: keoran_h
    en: Pull the scissors in the girl's pocket on the snake
    vn: "K\xE9o c\xE2y k\xE9o trong t\xFAi qu\u1EA7n c\xF4 g\xE1i v\xE0o con r\u1EAFn"
  - key: khi_s
    en: Monkeys swinging on trees is correct
    vn: "Kh\u1EC9 \u0111u tr\xEAn c\xE2y m\u1EDBi l\xE0 \u0111\xFAng"
  - key: khi_h
    en: Drag the monkey up the tree
    vn: "K\xE9o con kh\u1EC9 l\xEAn c\xE2y"
  - key: denpin_s
    en: Fireflies should be that bright
    vn: "\u0110om \u0111\xF3m ph\u1EA3i s\xE1ng nh\u01B0 v\u1EADy ch\u1EE9"
  - key: denpin_h
    en: Drag the flashlight onto the firefly
    vn: "K\xE9o \u0111\xE8n pin v\xE0o con \u0111om \u0111\xF3m"
  - key: bom_s
    en: Give it a long neck
    vn: "B\u01A1m cho n\xF3 1 c\xE1i c\u1ED5 d\xE0i"
  - key: bom_h
    en: Pull the wheel pump onto the ostrich
    vn: "K\xE9o c\xE1i b\u01A1m b\xE1nh xe v\xE0o con \u0111\xE0 \u0111i\u1EC3u"
  - key: loxo_s
    en: Rabbits should jump like that
    vn: "Th\u1ECF ph\u1EA3i nh\u1EA3y nh\u01B0 v\u1EADy m\u1EDBi \u0111\xFAng"
  - key: loxo_h
    en: Pull the spring onto the rabbit
    vn: "K\xE9o c\xE1i l\xF2 xo v\xE0o con th\u1ECF"
  - key: keo_h
    en: Pull the scissors from the girl's pocket onto the sofa
    vn: "K\xE9o c\xE2y k\xE9o trong t\xFAi qu\u1EA7n c\xF4 g\xE1i v\xE0o chi\u1EBFc
      gh\u1EBF sofa"
  - key: caheo_s
    en: Good fish go to the sea
    vn: "C\xE1 ngoan xu\u1ED1ng bi\u1EC3n nh\xE9"
  - key: caheo_h
    en: Drag the dolphin into the sea
    vn: "K\xE9o con c\xE1 heo xu\u1ED1ng bi\u1EC3n"
  - key: thit_s
    en: Eat meat, don't eat grass
    vn: "\u0102n th\u1ECBt \u0111i \u0111\u1EEBng \u0103n c\u1ECF n\u1EEFa"
  - key: thit_h
    en: Pull the meat to the lion
    vn: "K\xE9o mi\u1EBFng th\u1ECBt cho con s\u01B0 t\u1EED"
