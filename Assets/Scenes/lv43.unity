    targetId: chure
    stateId: used
    target: {fileID: 0}
  loseConditions: []
  timeLimit: 70
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Wedding day photoshoot
    vn: "Ch\u1EE5p \u1EA3nh ng\xE0y c\u01B0\u1EDBi"
  - key: des
    en: Get everyone ready and capture the perfect shot
    vn: "S\u1EAFp x\u1EBFp m\u1ECDi ng\u01B0\u1EDDi v\xE0 b\u1EAFt tr\u1ECDn kho\u1EA3nh
      kh\u1EAFc \u0111\u1EB9p nh\u1EA5t"
  - key: khantrum_h
    en: Drag the veil onto the bride
    vn: "K\xE9o kh\u0103n tr\xF9m v\xE0o c\xF4 d\xE2u"
  - key: khantrum_s
    en: Return this to the bride
    vn: "Tr\u1EA3 l\u1EA1i c\xE1i n\xE0y cho c\xF4 d\xE2u"
  - key: codaucuoi_h
    en: Tap on the bride
    vn: "B\u1EA5m v\xE0o c\xF4 d\xE2u"
  - key: codaucuoi_s
    en: Smile brightly
    vn: "C\u01B0\u1EDDi l\xEAn cho t\u01B0\u01A1i nh\xE9"
  - key: churehun_h
    en: Tap on the groom
    vn: "B\u1EA5m v\xE0o ch\xFA r\u1EC3"
  - key: churehun_s
    en: The groom kisses the bride!
    vn: "Ch\xFA r\u1EC3 hun c\xF4 d\xE2u \u0111i!"
  - key: gai2ao_h
    en: Click on the pink dress girl
    vn: "B\u1EA5m v\xE0o c\xF4 g\xE1i v\xE1y h\u1ED3ng"
  - key: gai2ao_s
    en: This jacket doesn't look right
    vn: "C\xE1i \xE1o kho\xE1c n\xE0y tr\xF4ng kh\xF4ng h\u1EE3p"
  - key: gai2cuoi_h
    en: Click on the pink dress girl
    vn: "B\u1EA5m v\xE0o c\xF4 g\xE1i v\xE1y h\u1ED3ng"
  - key: gai2cuoi_s
    en: Smile, girl!
    vn: "C\xF4 g\xE1i c\u01B0\u1EDDi l\xEAn n\xE0o!"
  - key: tochongty_h
    en: Click on the girl on the right
    vn: "B\u1EA5m v\xE0o c\xF4 g\xE1i b\xEAn ph\u1EA3i"
  - key: tochongty_s
    en: Take off this wig
    vn: "B\u1ECF c\xE1i b\u1ED9 t\xF3c gi\u1EA3 n\xE0y ra"
  - key: khautranghongty_h
    en: Click on the girl on the right
    vn: "B\u1EA5m v\xE0o c\xF4 g\xE1i b\xEAn ph\u1EA3i"
  - key: khautranghongty_s
    en: Taking a photo wearing a mask won't show your face
    vn: "Ch\u1EE5p h\xECnh m\xE0 \u0111eo kh\u1EA9u trang sao th\u1EA5y m\u1EB7t"
  - key: quanao_h
    en: Swipe up on the girl on the right
    vn: "Vu\u1ED1t l\xEAn c\xF4 g\xE1i b\xEAn ph\u1EA3i"
  - key: quanao_s
    en: Get rid of that dress
    vn: "B\u1ECF b\u1ED9 \u0111\u1EA7m \u0111\xF3 ra \u0111i"
  - key: vest_h
    en: Pull the black jacket on the girl on the right
    vn: "K\xE9o c\xE1i \xE1o kho\xE1c \u0111en v\xE0o c\xF4 g\xE1i b\xEAn ph\u1EA3i"
  - key: vest_s
    en: Doesn't it look much more polite?
    vn: "Tr\xF4ng c\xF3 l\u1ECBch s\u1EF1 h\u01A1n h\u1EB3n kh\xF4ng"
