  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2011352969}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv23
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: cone
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: hopdonghe
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: xabeng
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: den2
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: aoxanh
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: caidu
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: aochoang
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: tocgia
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cuocchim
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: vang
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: da
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: coson
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: tui_interact
    stateId: used
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: dongho
    stateId: used_lose
    target: {fileID: 0}
  timeLimit: 180
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Catch the bus
    vn: "B\u1EAFt xe"
  - key: des
    en: Help them catch the bus
    vn: "Gi\xFAp h\u1ECD b\u1EAFt \u0111\u01B0\u1EE3c xe bus"
  - key: taxi_s
    en: I call a taxi myself
    vn: "Ta t\u1EF1 g\u1ECDi taxi v\u1EADy"
  - key: taxi_h
    en: Click on the guy's bag
    vn: "B\u1EA5m v\xE0o t\xFAi \u0111eo c\u1EE7a ch\xE0ng trai"
  - key: du_s
    en: Use an umbrella to slow down the bus
    vn: "D\xF9ng d\xF9 \u0111\u1EC3 l\xE0m xe ch\u1EADm l\u1EA1i"
  - key: du_h
    en: Click on the girl to get the umbrella, then drag the umbrella onto the bus
    vn: "B\u1EA5m v\xE0o c\xF4 g\xE1i \u0111\u1EC3 l\u1EA5y d\xF9, sau \u0111\xF3
      k\xE9o d\xF9 v\xE0o xe bus"
  - key: cuocchim_h
    en: Drag the pickaxe into the cracked ground
    vn: "K\xE9o cu\u1ED1c chim v\xE0o ch\u1ED7 \u0111\u1EA5t c\xF3 v\u1EBFt n\u1EE9t"
  - key: aochoang_s
    en: I will stop the bus myself
    vn: "Ta s\u1EBD t\u1EF1 tay ch\u1EB7n chi\u1EBFc xe bus l\u1EA1i"
  - key: aochoang_h
    en: Pulling the red cloak on the billboard at the young man
    vn: "K\xE9o \xE1o cho\xE0ng \u0111\u1ECF tr\xEAn bi\u1EC3n qu\u1EA3ng c\xE1o
      v\xE0o ch\xE0ng trai"
  - key: dongho_lose_s
    en: It's late, no more guests!
    vn: "Tr\u1EC5 gi\u1EDD r\u1ED3i, kh\xF4ng \u0111\xF3n th\xEAm kh\xE1ch n\u1EEFa!"
  - key: dongho_lose_h
    en: Don't use the watch
    vn: "\u0110\u1EEBng s\u1EED d\u1EE5ng c\xE1i \u0111\u1ED3ng h\u1ED3"
  - key: aoxanh_s
    en: Borrow the policeman's shirt for a bit
    vn: "M\u01B0\u1EE3n \xE1o c\u1EE7a anh c\u1EA3nh s\xE1t 1 ch\xFAt"
  - key: aoxanh_h
    en: Pulling the policeman's shirt on the guy
    vn: "K\xE9o \xE1o c\u1EE7a c\u1EA3nh s\xE1t v\xE0o ch\xE0ng trai"
  - key: den2_s
    en: Turn the light red to stop
    vn: "Ch\u1EC9nh sang \u0111\xE8n \u0111\u1ECF \u0111\u1EC3 d\u1EEBng xe l\u1EA1i"
  - key: den2_h
    en: Click on the light switch
    vn: "B\u1EA5m v\xE0o c\xF4ng t\u1EAFc \u0111\xE8n"
  - key: tocgia_s
    en: Handsome driver, pick me up!
    vn: "Ch\xE0ng t\xE0i x\u1EBF \u0111\u1EB9p trai, \u0111\xF3n t\xF4i v\u1EDBi!"
  - key: tocgia_h
    en: Pulling the wig on the billboard at the guy
    vn: "K\xE9o t\xF3c gi\u1EA3 tr\xEAn bi\u1EC3n qu\u1EA3ng c\xE1o v\xE0o ch\xE0ng
      trai"
  - key: coson_s
    en: Change it to a bus stop sign
    vn: "Thay th\xE0nh bi\u1EC3n d\u1EEBng xe bus"
  - key: coson_h
    en: Drag the paintbrush onto the sign
    vn: "K\xE9o c\u1ECD s\u01A1n v\xE0o bi\u1EC3n b\xE1o"
  - key: da_s
    en: Block the road
    vn: "Ch\u1EB7n \u0111\u01B0\u1EDDng xe l\u1EA1i"
  - key: da_h
    en: Drag the pile of rocks in the left corner onto the path
    vn: "K\xE9o \u0111\u1ED1ng \u0111\xE1 \u1EDF g\xF3c tr\xE1i v\xE0o \u0111\u01B0\u1EDDng
      \u0111i"
  - key: hopdonghe_h
    en: Click on the red toolbox
    vn: "B\u1EA5m v\xE0o h\u1ED9p \u0111\u1ED3 ngh\u1EC1 m\xE0u \u0111\u1ECF"
  - key: xabeng_h
    en: Pull the crowbar into the light pole galvanometer box
    vn: "K\xE9o x\xE0 beng v\xE0o h\u1ED9p \u0111i\u1EC7n k\u1EBF c\u1ED9t \u0111\xE8n"
  - key: vang_s
    en: Stop and I'll give you some gold
    vn: "D\u1EEBng l\u1EA1i \u0111i r\u1ED3i t\xF4i chia cho m\u1ED9t \xEDt v\xE0ng"
  - key: vang_h
    en: Pull gold on the guy
    vn: "K\xE9o v\xE0ng v\xE0o ch\xE0ng trai"
  - key: cone_s
    en: Block the road
    vn: "Ch\u1EB7n \u0111\u01B0\u1EDDng xe l\u1EA1i"
  - key: cone_h
    en: Pull the cones down the road
    vn: "K\xE9o c\u1ECDc ti\xEAu xu\u1ED1ng \u0111\u01B0\u1EDDng"
