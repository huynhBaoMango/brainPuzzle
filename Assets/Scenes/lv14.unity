--- !u!114 &2095682931
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2095682929}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv14
  title: title
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 519420031}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: cogai
    stateId: meo
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: chuong
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: lycf
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: loa
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: no
    target: {fileID: 0}
  - type: 0
    targetId: tu_interact
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: tat
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: mycay
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: me
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: cauphatsang
    target: {fileID: 0}
  - type: 0
    targetId: cuaso
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: ong
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: cogai
    stateId: dt_lose
    target: {fileID: 0}
  - type: 0
    targetId: cogai
    stateId: bitmat_lose
    target: {fileID: 0}
  timeLimit: 150
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: title
    en: Do homework
    vn: "L\xE0m b\xE0i t\u1EADp"
  - key: des
    en: Keep the girl awake to complete the assignment
    vn: "Gi\u1EEF c\xF4 g\xE1i t\u1EC9nh t\xE1o \u0111\u1EC3 ho\xE0n th\xE0nh b\xE0i
      t\u1EADp"
  - key: intro_cogai
    en: Okay, let's focus on homework!
    vn: "\u0110\u01B0\u1EE3c r\u1ED3i t\u1EADp trung l\xE0m b\xE0i t\u1EADp th\xF4i!"
  - key: intro_2cogai
    en: 5 minutes later...
    vn: "5 ph\xFAt sau..."
  - key: cuaso_h
    en: Tap the window
    vn: "Ch\u1EA1m v\xE0o c\u1EEDa s\u1ED5"
  - key: stillasleep_success
    en: Still sleepy...
    vn: "V\u1EABn bu\u1ED3n ng\u1EE7..."
  - key: meo_s
    en: (Everything ends up on my plate!)
    vn: "(Vi\u1EC7c g\xEC c\u0169ng t\u1EDBi tay ta)"
  - key: meo_h
    en: Drag the cat onto the girl
    vn: "K\xE9o con m\xE8o v\xE0o c\xF4 g\xE1i"
  - key: chuong_s
    en: The bell startled me
    vn: "Ti\u1EBFng chu\xF4ng l\xE0m t\xF4i gi\u1EADt m\xECnh "
  - key: chuong_h
    en: Drag the bell on the shelf at the girl
    vn: "K\xE9o chu\xF4ng tr\xEAn k\u1EC7 v\xE0o c\xF4 g\xE1i"
  - key: loa_s
    en: How can you sleep with such noise!
    vn: "\u1ED2n nh\u01B0 v\u1EA7y sao m\xE0 ng\u1EE7 ch\u1EE9!"
  - key: loa_h
    en: Tap on the speaker to play music
    vn: "B\u1EA5m v\xE0o loa ph\xE1t nh\u1EA1c"
  - key: no_s
    en: I heard this helps you focus
    vn: "Nghe n\xF3i l\xE0m nh\u01B0 v\u1EA7y s\u1EBD t\u1EADp trung h\u01A1n"
  - key: no_h
    en: Drag the bow on the ceiling lamp at the girl
    vn: "K\xE9o n\u01A1 tr\xEAn \u0111\xE8n tr\u1EA7n v\xE0o c\xF4 g\xE1i"
  - key: tat_s
    en: These socks stink me awake
    vn: "T\u1EA5t th\u1ED1i t\u1EC9nh c\u1EA3 ng\u1EE7 lu\xF4n"
  - key: tat_h
    en: Drag the socks from the closet to the girl
    vn: "K\xE9o t\u1EA5t trong t\u1EE7 v\xE0o c\xF4 g\xE1i"
  - key: ong_s
    en: Bee stings hurt so much!
    vn: "Ong ch\xEDch \u0111au qu\xE1!"
  - key: ong_h
    en: Tap on the hive
    vn: "B\u1EA5m v\xE0o t\u1ED5 ong"
  - key: mycay_s
    en: Spicy will wake you up!
    vn: "Cay s\u1EBD l\xE0m t\u1EC9nh t\xE1o!"
  - key: mycay_h
    en: Drag the bowl of noodles in the poster to the girl
    vn: "K\xE9o t\xF4 m\xEC trong poster v\xE0o c\xF4 g\xE1i"
  - key: me_s
    en: Don't you dare fall asleep!
    vn: "Ng\u1EE7 l\xE0 \u0103n roi li\u1EC1n \u0111\xF3!"
  - key: me_h
    en: Tap on the photo of mother in the back
    vn: "B\u1EA5m v\xE0o b\u1EE9c \u1EA3nh c\u1EE7a m\u1EB9 ph\xEDa sau"
  - key: cauphatsang_s
    en: Strobe lights!
    vn: "\u0110\xE8n nh\xE1y x\u1EADp x\xECnh!"
  - key: cauphatsang_h
    en: Drag the glass ball into the electrical outlet
    vn: "K\xE9o qu\u1EA3 c\u1EA7u th\u1EE7y tinh v\xE0o \u1ED5 \u0111i\u1EC7n"
  - key: lycf_s
    en: Coffee helps stay awake
    vn: "C\xE0 ph\xEA gi\xFAp \xEDch cho vi\u1EC7c t\u1EC9nh t\xE1o"
  - key: lycf_h
    en: Drag the coffee cup to the girl
    vn: "K\xE9o ly c\xE0 ph\xEA v\xE0o c\xF4 g\xE1i"
  - key: dt_lose_s
    en: I'm awake now, but I can't focus on my homework anymore!
    vn: "T\xF4i t\u1EC9nh ng\u1EE7 r\u1ED3i, nh\u01B0ng kh\xF4ng th\u1EC3 t\u1EADp
      trung v\xE0o b\xE0i t\u1EADp n\u1EEFa!"
  - key: dt_lose_hint
    en: Don't let girls use the phone
    vn: "\u0110\u1EEBng cho c\xF4 g\xE1i s\u1EED d\u1EE5ng \u0111i\u1EC7n tho\u1EA1i"
  - key: bitmat_lose_s
    en: This helps me sleep much better
    vn: "Th\u1EE9 n\xE0y gi\xFAp t\xF4i ng\u1EE7 ngon h\u01A1n nhi\u1EC1u"
  - key: bitmat_lose_h
    en: Don't let the girl wear a blindfold
    vn: "\u0110\u1EEBng cho c\xF4 g\xE1i s\u1EED d\u1EE5ng \u0111\u1ED3 b\u1ECBt
      m\u1EAFt"
  - key: tu_h
    en: Tap on the white cabinet to open it
    vn: "B\u1EA5m v\xE0o t\u1EE7 tr\u1EAFng \u0111\u1EC3 m\u1EDF"
