    target: {fileID: 0}
  - type: 0
    targetId: cua
    stateId: cuaDrag
    target: {fileID: 0}
  timeLimit: 180
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: lv10Title
    en: Rescue the girl.
    vn: "Gi\u1EA3i c\u1EE9u c\xF4 g\xE1i."
  - key: lv10Des
    en: Help the girl escape from the crocodile cage
    vn: "Gi\xFAp c\xF4 g\xE1i tho\xE1t kh\u1ECFi chu\u1ED3ng c\xE1 s\u1EA5u"
  - key: day1Hint
    en: Pull the rope to the ladder
    vn: "K\xE9o s\u1EE3i d\xE2y v\xE0o c\xE1i thang"
  - key: CaHint
    en: Drag the fish to the ladder
    vn: "K\xE9o con c\xE1 v\xE0o c\xE1i thang"
  - key: AnXinDuaThauHint
    en: Click on the beggar to get the brass
    vn: "\u1EA4n v\xE0o ng\u01B0\u1EDDi \u0103n xin \u0111\u1EC3 l\u1EA5y thau"
  - key: TaoDragSuccess
    en: The apple smells evil good.
    vn: "Qu\u1EA3 t\xE1o th\u01A1m \xE1c."
  - key: TaoDragXuongSongHint
    en: Drag this apple into the river
    vn: "K\xE9o qu\u1EA3 t\xE1o n\xE0y xu\u1ED1ng s\xF4ng"
  - key: AnVaoDaSuccess
    en: There's a saw here!
    vn: "C\xF3 c\xE1i c\u01B0a \u1EDF \u0111\xE2y n\xE8!"
  - key: AnVaoDaHint
    en: Press on the ice.
    vn: "\u1EA4n v\xE0o c\u1EE5c \u0111\xE1."
  - key: keoDragHint
    en: Pull the scissors to the person asking for help.
    vn: "K\xE9o c\xE2y k\xE9o v\xE0o ng\u01B0\u1EDDi c\u1EA7u c\u1EE9u."
  - key: BienHieuHint
    en: Pull the warning sign onto the ladder
    vn: "K\xE9o bi\u1EC3n hi\u1EC7u c\u1EA3nh b\xE1o v\xE0o c\xE1i thang"
  - key: vienGach1Hint
    en: Drag the brick to the ladder
    vn: "K\xE9o vi\xEAn g\u1EA1ch v\xE0o c\xE1i thang"
  - key: CuaWarningHint
    en: Don't mess around with the saw.
    vn: "\u0110\u1EEBng c\xF3 t\xE1y m\xE1y s\u1EED d\u1EE5ng c\u01B0a."
  - key: nu8DuaKeoHint
    en: Press on the woman to get the scissors
    vn: "\u1EA4n v\xE0o ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF \u0111\u1EC3 l\u1EA5y k\xE9o"
  - key: MovePos1Success
    en: Be gentle, do not wake the crocodile
    vn: "Ph\u1EA3i nh\u1EB9 nh\xE0ng, kh\xF4ng \u0111\u01B0\u1EE3c \u0111\xE1nh th\u1EE9c
      con c\xE1 s\u1EA5u"
  - key: MovePos2Success
    en: Almost there, just a little more
    vn: "S\u1EAFp t\u1EDBi r\u1ED3i, m\u1ED9t ch\xFAt n\u1EEFa th\xF4i"
  - key: MovePos3Victory
    en: So amazing, SAVED!!!
    vn: "Qu\xE1 tuy\u1EC7t v\u1EDDi, \u0110\u01AF\u1EE2C C\u1EE8U R\u1ED2I!!!"
  - key: tuiDragHint
    en: Drag the bag to the ladder
    vn: "K\xE9o t\xFAi x\xE1ch v\xE0o c\xE1i thang"
  - key: BuaDapTuongSuccess
    en: Drops this brick. Looks like it will help
    vn: "R\u01A1i ra vi\xEAn g\u1EA1ch n\xE0y. C\xF3 v\u1EBB n\xF3 s\u1EBD gi\xFAp
      \xEDch"
  - key: DragBuaDapTuongHint
    en: Pull the hammer into the crack
    vn: "K\xE9o c\xE2y b\xFAa v\xE0o ch\u1ED7 b\u1ECB n\u1EE9t"
  - key: ThauDragHint
    en: Drag the water bucket to the ladder
    vn: "K\xE9o thau n\u01B0\u1EDBc v\xE0o c\xE1i thang"
  - key: VanDragHint
    en: Drag the skateboard to the ladder
    vn: "K\xE9o v\xE1n tr\u01B0\u1EE3t v\xE0o c\xE1i thang"
  - key: CauBeDuaVanTruotHint
    en: Click on the boy to borrow the skateboard
    vn: "\u1EA4n v\xE0o c\u1EADu b\xE9 \u0111\u1EC3 m\u01B0\u1EE3n v\xE1n tr\u01B0\u1EE3t"
  - key: namTapBuaHint
    en: Click on the man to get the tool.
    vn: "\u1EA4n v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng \u0111\u1EC3 l\u1EA5y
      d\u1EE5ng c\u1EE5."
  - key: TaoDragVaoNu9Hint
    en: Don't feed the woman rotten apples
    vn: "\u0110\u1EEBng c\xF3 cho ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF \u0103n t\xE1o
      th\u1ED1i"
  - key: Nu9LayTuiXachHint
    en: Click on the woman to get her handbag
    vn: "\u1EA4n v\xE0o ng\u01B0\u1EDDi ph\u1EE5 n\u1EEF \u0111\u1EC3 l\u1EA5y t\xFAi
      x\xE1ch"
