  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv10
  title: lv10Title
  description: lv10Des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 519420031}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: thau1
    stateId: thau1Drag
    target: {fileID: 0}
  - type: 0
    targetId: van1
    stateId: van1Drag
    target: {fileID: 0}
  - type: 0
    targetId: gach1
    stateId: gach1Drag
    target: {fileID: 0}
  - type: 0
    targetId: da
    stateId: daDrag
    target: {fileID: 0}
  - type: 0
    targetId: tuixach1
    stateId: tuixach1Drag
    target: {fileID: 0}
  - type: 0
    targetId: keo
    stateId: keoDrag
    target: {fileID: 0}
  - type: 0
    targetId: bienHieu1
    stateId: bienHieu1Drag
    target: {fileID: 0}
  - type: 0
    targetId: day1
    stateId: day1Drag
    target: {fileID: 0}
  - type: 0
    targetId: tao
    stateId: TaoDragVoNu9TocNgan
    target: {fileID: 0}
  - type: 0
    targetId: tao
    stateId: TaoDragXuongSong
    target: {fileID: 0}
  - type: 0
    targetId: ca
    stateId: caDrag
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: tao
    stateId: TaoDragVoNu9TocNgan
    target: {fileID: 0}
  - type: 0
    targetId: tao
