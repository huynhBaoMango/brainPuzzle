--- !u!114 &277809951
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 277809950}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv38
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: baotay
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: khautrang
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: mu
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: btallow1
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: bua
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: toi
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: btdeny2
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: toi2
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: hoa
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: mattrang
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: dendau
    stateId: used
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: btdeny1
    stateId: used_lose
    target: {fileID: 0}
  - type: 0
    targetId: btallow2
    stateId: used_lose
    target: {fileID: 0}
  - type: 0
    targetId: btdeny3
    stateId: used_lose
    target: {fileID: 0}
  - type: 0
    targetId: btallow3
    stateId: used_lose
    target: {fileID: 0}
  timeLimit: 180
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Motel
    vn: "Nh\xE0 tr\u1ECD"
  - key: des
    en: Check visitors to see if they are human
    vn: "Ki\u1EC3m tra c\xE1c kh\xE1ch v\xE0o nh\xE0 xem h\u1ECD c\xF3 ph\u1EA3i
      con ng\u01B0\u1EDDi kh\xF4ng"
  - key: mu_s
    en: Oh that's just my hat
    vn: "\u1ED2 \u0111\xF3 ch\u1EC9 l\xE0 m\u0169 c\u1EE7a ta th\xF4i"
  - key: mu_h
    en: Click on the girl's hat
    vn: "B\u1EA5m v\xE0o m\u0169 c\xF4 g\xE1i"
  - key: intro
    en: Today, you're responsible for checking every guest for any irregularities
    vn: "H\xF4m nay, ng\u01B0\u01A1i ph\u1EA3i ki\u1EC3m tra to\xE0n b\u1ED9 kh\xE1ch
      check-in \u0111\u1EC3 \u0111\u1EA3m b\u1EA3o kh\xF4ng c\xF3 v\u1EA5n \u0111\u1EC1"
  - key: win
    en: Good job! Last night there were no problems
    vn: "L\xE0m t\u1ED1t l\u1EAFm! T\u1ED1i qua \u0111\xE3 kh\xF4ng c\xF3 v\u1EA5n
      \u0111\u1EC1 g\xEC"
  - key: bua_s
    en: His eyes are so scary
    vn: "\u0110\xF4i m\u1EAFt c\u1EE7a h\u1EAFn \u0111\xE1ng s\u1EE3 qu\xE1"
  - key: bua_h
    en: Tap on the paper on the man's forehead
    vn: "B\u1EA5m v\xE0o t\u1EA5m b\xF9a tr\xEAn tr\xE1n ng\u01B0\u1EDDi \u0111\xE0n
      \xF4ng"
  - key: nuhello_s
    en: Hello, sweetheart. I booked a room in advance
    vn: "Ch\xE0o c\u1EE5c v\xE0ng, ta \u0111\xE3 \u0111\u1EB7t ph\xF2ng tr\u01B0\u1EDBc
      \u0111\xF3 r\u1ED3i!"
  - key: cogai_pass_s
    en: Thank you, sweetheart!
    vn: "C\u1EA3m \u01A1n nh\xE9 c\u1EE5c v\xE0ng!"
  - key: allow1_h
    en: Tap on the green button allows the girl to pass
    vn: "B\u1EA5m v\xE0o n\xFAt xanh cho ph\xE9p c\xF4 g\xE1i th\xF4ng qua"
  - key: btdeny2_h
    en: Tap the red button does not allow the man through
    vn: "B\u1EA5m v\xE0o n\xFAt \u0111\u1ECF kh\xF4ng cho ph\xE9p ng\u01B0\u1EDDi
      \u0111\xE0n \xF4ng th\xF4ng qua"
  - key: trang_s
    en: Oh no, the blood moon makes me...
    vn: "\xD4i kh\xF4ng, tr\u0103ng m\xE1u l\xE0m ta..."
  - key: trang_h
    en: Tap on the moon
    vn: "B\u1EA5m v\xE0o m\u1EB7t tr\u0103ng"
  - key: toi2_h
    en: Pull the garlic on the table at the man
    vn: "K\xE9o t\u1ECFi tr\xEAn b\xE0n v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: toi_s
    en: I... I hate this
    vn: "Ta.. ta gh\xE9t th\u1EE9 n\xE0y"
  - key: toi_h
    en: Pull the bunch of garlic onto the man
    vn: "K\xE9o ch\xF9m t\u1ECFi v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: nguoisoihello_s
    en: Hello hello, I have a flower for you
    vn: "Xin ch\xE0o xin ch\xE0o, ta c\xF3 m\u1ED9t b\xF4ng hoa cho c\u1EADu \u0111\xE2y"
  - key: nguoisoi_done_s
    en: I'm on fire, what are you doing!!
    vn: "Ta b\u1ECB ch\xE1y r\u1ED3i, ng\u01B0\u01A1i l\xE0m g\xEC v\u1EADy h\u1EA3!!"
  - key: baotay_s
    en: Those are just my gloves
    vn: "\u0110\xF3 ch\u1EC9 l\xE0 g\u0103ng tay c\u1EE7a ta th\xF4i"
  - key: baotay_h
    en: Click on the girl's gloves
    vn: "B\u1EA5m v\xE0o g\u0103ng tay c\u1EE7a c\xF4 g\xE1i"
  - key: den_h
    en: Pull the lamp onto the werewolf
    vn: "K\xE9o \u0111\xE8n v\xE0o ng\u01B0\u1EDDi s\xF3i"
  - key: khautrang_s
    en: You want to see my beauty, sweetheart?
    vn: "Ng\u01B0\u01A1i mu\u1ED1n xem s\u1EF1 xinh \u0111\u1EB9p c\u1EE7a ta h\u1EA3,
      c\u01B0ng?"
  - key: khautrang_h
    en: Click on the girl's mask
    vn: "B\u1EA5m v\xE0o kh\u1EA9u trang c\u1EE7a c\xF4 g\xE1i"
  - key: cuongthihello_s
    en: Hi.
    vn: "Ch\xE0o."
  - key: cuongthidoa_s
    en: Let me in or I'll...
    vn: "Cho ta v\xE0o kh\xF4ng ta s\u1EBD..."
  - key: cuongthi_done_s
    en: He attacked me with garlic!
    vn: "H\u1EAFn t\u1EA5n c\xF4ng ta b\u1EB1ng t\u1ECFi!"
  - key: hoa_h
    en: Drag the flower into the vase on the table
    vn: "K\xE9o hoa v\xE0o b\xECnh hoa tr\xEAn b\xE0n"
  - key: cogai_lose
    en: But I'm a real human...
    vn: "Nh\u01B0ng ta l\xE0 ng\u01B0\u1EDDi th\u1EADt m\xE0..."
  - key: lose
    en: I will eat you
    vn: "Ta s\u1EBD \u0103n th\u1ECBt ng\u01B0\u01A1i"
