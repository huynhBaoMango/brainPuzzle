  defaultHintMessageKey: 
  strings:
  - key: title
    en: Good night's sleep
    vn: "Gi\u1EA5c ng\u1EE7 ngon"
  - key: des
    en: Help grandma get a good night's sleep
    vn: "Gi\xFAp b\xE0 c\xF3 1 gi\u1EA5c ng\u1EE7 ngon"
  - key: tuong_s
    en: Walls can also be used as mattresses
    vn: "T\u01B0\u1EDDng c\u0169ng c\xF3 th\u1EC3 l\xE0m n\u1EC7m"
  - key: tuong_h
    en: Drag the wall to the bed
    vn: "K\xE9o t\u01B0\u1EDDng v\xE0o gi\u01B0\u1EDDng"
  - key: khan_s
    en: Towels can also be used as mattresses
    vn: "Kh\u0103n c\u0169ng c\xF3 th\u1EC3 l\xE0m n\u1EC7m"
  - key: khan_h
    en: Drag the towel from the chair onto the bed
    vn: "K\xE9o kh\u0103n tr\xEAn gh\u1EBF v\xE0o gi\u01B0\u1EDDng"
  - key: xuongrong_lose_s
    en: How can her sleep with these thorns!
    vn: "Sao m\xE0 ng\u1EE7 \u0111\u01B0\u1EE3c v\u1EDBi \u0111\u1ED1ng gai n\xE0y
      ch\u1EE9!"
  - key: xuongrong_lose_h
    en: Don't use cacti
    vn: "\u0110\u1EEBng s\u1EED d\u1EE5ng x\u01B0\u01A1ng r\u1ED3ng"
  - key: len_s
    en: Her woolen towel can also be used as a mattress
    vn: "Kh\u0103n len c\u1EE7a b\xE0 c\u0169ng c\xF3 th\u1EC3 l\xE0m n\u1EC7m"
  - key: len_h
    en: Drag the wool towel from the chair onto the bed
    vn: "K\xE9o kh\u0103n len tr\xEAn gh\u1EBF v\xE0o gi\u01B0\u1EDDng"
  - key: cho_lose_s
    en: 
    vn: 
  - key: cho_lose_h
    en: Don't touch the dog
    vn: "\u0110\u1EEBng \u0111\u1ED9ng v\xE0o con ch\xF3"
  - key: tham_s
    en: Carpets can also be used as mattresses
    vn: "Th\u1EA3m c\u0169ng c\xF3 th\u1EC3 l\xE0m n\u1EC7m"
  - key: tham_h
    en: Drag the carpet on the floor to the bed
    vn: "K\xE9o th\u1EA3m tr\xEAn s\xE0n v\xE0o gi\u01B0\u1EDDng"
  - key: rem_s
    en: Curtains can also act as mattresses
    vn: "R\xE8m c\u1EEDa c\u0169ng c\xF3 th\u1EC3 l\xE0m n\u1EC7m"
  - key: rem_h
    en: Drag the curtains to the bed
    vn: "K\xE9o r\xE8m c\u1EEDa v\xE0o gi\u01B0\u1EDDng"
  - key: cuu_s
    en: Sheep's wool can also be used to make mattresses
    vn: "L\xF4ng c\u1EEBu c\u0169ng c\xF3 th\u1EC3 l\xE0m n\u1EC7m"
  - key: cuu_h
    en: Tap to open the window
    vn: "B\u1EA5m \u0111\u1EC3 m\u1EDF c\u1EEDa s\u1ED5"
  - key: khanban_s
    en: Tablecloths can also be used as mattresses
    vn: "Kh\u0103n b\xE0n c\u0169ng c\xF3 th\u1EC3 l\xE0m n\u1EC7m"
  - key: khanban_h
    en: Drag the tablecloth to the bed
    vn: "K\xE9o kh\u0103n b\xE0n v\xE0o gi\u01B0\u1EDDng"
  - key: ghe_s
    en: Chair cushions can also be used as mattresses
    vn: "\u0110\u1EC7m gh\u1EBF c\u0169ng c\xF3 th\u1EC3 l\xE0m n\u1EC7m"
  - key: ghe_h
    en: Drag the chair cushion to the bed
    vn: "K\xE9o \u0111\u1EC7m gh\u1EBF v\xE0o gi\u01B0\u1EDDng"
  - key: ong_s
    en: This mattress has grandpa's love
    vn: "N\u1EC7m n\xE0y c\xF3 t\xECnh y\xEAu c\u1EE7a \xF4ng"
  - key: ong_h
    en: Tap on the picture of grandparents
    vn: "B\u1EA5m v\xE0o tranh c\u1EE7a \xF4ng b\xE0"
  - key: den_s
    en: Lamps can also be used as mattresses
    vn: "\u0110\xE8n c\u0169ng c\xF3 th\u1EC3 l\xE0m n\u1EC7m"
  - key: den_h
    en: Drag the lamp into bed
    vn: "K\xE9o \u0111\xE8n ng\u1EE7 v\xE0o gi\u01B0\u1EDDng"
  - key: lose
    en: 
    vn: 
  - key: win
    en: Finally i can sleep well
    vn: "Cu\u1ED1i c\xF9ng ta c\u0169ng c\xF3 th\u1EC3 ng\u1EE7 ngon r\u1ED3i"
