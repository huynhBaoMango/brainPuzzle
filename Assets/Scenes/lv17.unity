  defaultHintMessageKey: 
  strings:
  - key: title
    en: Brew a potion
    vn: "Pha ch\u1EBF thu\u1ED1c"
  - key: des
    en: Learn how to brew a rejuvenation potion for the witch
    vn: "Ho\xE0n th\xE0nh c\xF4ng th\u1EE9c thu\u1ED1c tr\u1EBB h\xF3a cho ph\xF9
      th\u1EE7y"
  - key: binhtim_s
    en: Purple potion
    vn: "Thu\u1ED1c t\xEDm"
  - key: binhtim_h
    en: Drag the purple potion into the liquid tester to see if it is safe
    vn: "K\xE9o thu\u1ED1c t\xEDm v\xE0o m\xE1y ki\u1EC3m tra ch\u1EA5t l\u1ECFng
      xem c\xF3 an to\xE0n kh\xF4ng"
  - key: binhxanh_s
    en: Green potion
    vn: "Thu\u1ED1c xanh"
  - key: binhxanh_lose_h
    en: Drag the green potion into the liquid tester to see if it is safe
    vn: "K\xE9o thu\u1ED1c xanh v\xE0o m\xE1y ki\u1EC3m tra ch\u1EA5t l\u1ECFng xem
      c\xF3 an to\xE0n kh\xF4ng"
  - key: binhnuoc_s
    en: Pure water
    vn: "Nu\u1EDBc tinh khi\u1EBFt"
  - key: binhnuoc_h
    en: Drag the water bottle on the table into the pot
    vn: "K\xE9o b\xECnh n\u01B0\u1EDBc tr\xEAn b\xE0n v\xE0o n\u1ED3i"
  - key: binhhoa_s
    en: Rose petals
    vn: "C\xE1nh hoa h\u1ED3ng"
  - key: binhhoa_h
    en: Drag the vase of roses into the pot
    vn: "K\xE9o b\xECnh hoa h\u1ED3ng v\xE0o n\u1ED3i"
  - key: binhdokho_s
    en: Dried fruits
    vn: "Hoa qu\u1EA3 kh\xF4"
  - key: binhdokho_h
    en: Drag the jar of dried fruit into the pot
    vn: "K\xE9o b\xECnh hoa qu\u1EA3 kh\xF4 v\xE0o n\u1ED3i"
  - key: binhla_s
    en: Herbal leaves
    vn: "L\xE1 th\u1EA3o d\u01B0\u1EE3c"
  - key: binhla_h
    en: Drag the jar of herbal leaves into the pot
    vn: "K\xE9o b\xECnh l\xE1 th\u1EA3o d\u01B0\u1EE3c v\xE0o n\u1ED3i"
  - key: binhtimthua_s
    en: Fermented jam
    vn: "M\u1EE9t l\xEAn men"
  - key: binhtimthua_h
    en: Do not put the jar of fermented jam into the pot
    vn: "\u0110\u1EEBng cho b\xECnh m\u1EE9t l\xEAn men v\xE0o n\u1ED3i"
  - key: coixay_s
    en: Herbal powder
    vn: "B\u1ED9t th\u1EA3o d\u01B0\u1EE3c"
  - key: coixay_h
    en: Put the herbal leaves on the table into the blender
    vn: "Cho c\xE1c l\xE1 th\u1EA3o d\u01B0\u1EE3c tr\xEAn b\xE0n v\xE0o c\u1ED1i
      xay"
  - key: hinh_s
    en: Model of a beautiful girl
    vn: "H\xECnh m\u1EABu m\u1ED9t c\xF4 g\xE1i \u0111\u1EB9p"
  - key: hinh_h
    en: Drag the knife to the girl painting on the wall to get the model
    vn: "K\xE9o dao v\xE0o tranh c\xF4 g\xE1i tr\xEAn t\u01B0\u1EDDng \u0111\u1EC3
      l\u1EA5y h\xECnh m\u1EABu"
  - key: diem2_h
    en: Drag the matchbox into the kitchen when the ingredients are ready
    vn: "K\xE9o h\u1ED9p di\xEAm v\xE0o b\u1EBFp khi c\xE1c nguy\xEAn li\u1EC7u \u0111\xE3
      s\u1EB5n s\xE0ng"
  - key: diem1_h
    en: Tap on the matchbox to open it
    vn: "B\u1EA5m v\xE0o h\u1ED9p di\xEAm \u0111\u1EC3 m\u1EDF ra"
