MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1637235453}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv24
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: phao
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: vit
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: mangnhen
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: manhinh
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: ao
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cuatu1
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: keo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cuatu2
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: keodan
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: linhkien
    stateId: used
    target: {fileID: 0}
  loseConditions: []
  timeLimit: 90
  timeUpTarget: {fileID: 1920941527}
  timeUpStateId: lose
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Deep trouble
    vn: "Nguy hi\u1EC3m d\u01B0\u1EDBi n\u01B0\u1EDBc"
  - key: des
    en: Find a way to stop the flow of water
    vn: "T\xECm c\xE1ch ng\u0103n d\xF2ng n\u01B0\u1EDBc ch\u1EA3y l\u1EA1i"
  - key: mangnhen_s
    en: Use spider web!
    vn: "D\xF9ng m\u1EA1ng nh\u1EC7n!"
  - key: mangnhen_h
    en: Pull the spider web into the hole
    vn: "K\xE9o m\u1EA1ng nh\u1EC7n v\xE0o l\u1ED7 h\u1ED5ng"
  - key: manhinh_s
    en: This screen also works!
    vn: "M\xE0n h\xECnh n\xE0y c\u0169ng d\xF9ng \u0111\u01B0\u1EE3c!"
  - key: manhinh_h
    en: Drag the screen into the hole
    vn: "K\xE9o m\xE0n h\xECnh v\xE0o l\u1ED7 h\u1ED5ng"
  - key: ao_s
    en: The shirt will definitely keep out quite a bit of water
    vn: "\xC1o ch\u1EAFc ch\u1EAFn s\u1EBD ng\u0103n \u0111\u01B0\u1EE3c kha kh\xE1
      n\u01B0\u1EDBc"
  - key: ao_h
    en: Click on the girl to get the shirt
    vn: "B\u1EA5m v\xE0o c\xF4 g\xE1i \u0111\u1EC3 l\u1EA5y \xE1o"
  - key: keodan_s
    en: Apply duct tape to the hole
    vn: "D\xE1n b\u0103ng keo v\xF4 l\u1ED7 h\u1ED5ng"
  - key: keodan_h
    en: Pull the tape from the underwater cabinet into the hole
    vn: "K\xE9o cu\u1ED9n b\u0103ng keo trong t\u1EE7 d\u01B0\u1EDBi n\u01B0\u1EDBc
      v\xE0o l\u1ED7 h\u1ED5ng"
  - key: vit_s
    en: "It won\u2019t hold back much, but every bit helps"
    vn: "Ng\u0103n \u0111\u01B0\u1EE3c ch\u1EEBng n\xE0o hay ch\u1EEBng \u1EA5y!"
  - key: vit_h
    en: Drag the duck into the hole
    vn: "K\xE9o con v\u1ECBt v\xE0o l\u1ED7 h\u1ED5ng"
  - key: phao_s
    en: Buoy to fix broken glass
    vn: "C\xE1i phao \u0111\u1EC3 c\u1ED1 \u0111\u1ECBnh k\xEDnh v\u1EE1 l\u1EA1i"
  - key: phao_h
    en: Pull the float into the hole
    vn: "K\xE9o c\xE1i phao v\xE0o l\u1ED7 h\u1ED5ng"
  - key: keo_s
    en: Super glue will come in handy
    vn: "Keo si\xEAu d\xEDnh s\u1EBD c\xF3 \xEDch!"
  - key: keo_h
    en: Pull the glue in the underwater cabinet into the hole
    vn: "K\xE9o keo trong t\u1EE7 d\u01B0\u1EDBi n\u01B0\u1EDBc v\xE0o l\u1ED7 h\u1ED5ng"
  - key: tu1_h
    en: Click on the underwater cabinet on the left to open it
    vn: "B\u1EA5m v\xE0o t\u1EE7 d\u01B0\u1EDBi n\u01B0\u1EDBc b\xEAn tr\xE1i \u0111\u1EC3
      m\u1EDF"
  - key: tu2_h
    en: Click on the underwater cabinet on the right to open it
    vn: "B\u1EA5m v\xE0o t\u1EE7 d\u01B0\u1EDBi n\u01B0\u1EDBc b\xEAn ph\u1EA3i \u0111\u1EC3
      m\u1EDF"
  - key: linhkien_s
    en: This is whatever it is!
    vn: "C\xE1i n\xE0y l\xE0 c\xE1i g\xEC c\u0169ng \u0111\u01B0\u1EE3c!"
  - key: linhkien_h
    en: Drag the underwater object in the bottom left corner into the opening
    vn: "K\xE9o v\u1EADt d\u01B0\u1EDBi n\u01B0\u1EDBc \u1EDF d\u01B0\u1EDBi g\xF3c
      tr\xE1i v\xE0o l\u1ED7 h\u1ED5ng"
