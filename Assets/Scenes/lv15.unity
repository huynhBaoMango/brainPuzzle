  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: title
    en: Kill rats
    vn: "Di\u1EC7t chu\u1ED9t"
  - key: des
    en: Eliminate all rats
    vn: "Ti\xEAu di\u1EC7t to\xE0n b\u1ED9 chu\u1ED9t"
  - key: tulanh2_h
    en: Tap on the wooden cabinet on the refrigerator
    vn: "B\u1EA5m v\xE0o t\u1EE7 g\u1ED7 tr\xEAn t\u1EE7 l\u1EA1nh"
  - key: btquat_s
    en: Suck all the rats out
    vn: "H\xFAt h\u1EBFt \u0111\xE1m chu\u1ED9t ra"
  - key: btquat_h
    en: Tap on the blue button under the fan
    vn: "B\u1EA5m v\xE0o n\xFAt xanh d\u01B0\u1EDBi qu\u1EA1t gi\xF3"
  - key: binhnuoctapped_s
    en: They got into the water tank, so I can't spray insecticide
    vn: "Ch\xFAng v\xE0o trong b\xECnh n\u01B0\u1EDBc r\u1ED3i,kh\xF4ng th\u1EC3
      x\u1ECBt thu\u1ED1c \u0111\u01B0\u1EE3c"
  - key: chinhnhietdo_s
    en: Set it to maximum cold and freeze the rats
    vn: "Ch\u1EC9nh l\u1EA1nh h\u1EBFt c\u1EE1 \u0111\u1EC3 \u0111\xF3ng b\u0103ng
      l\u0169 chu\u1ED9t"
  - key: chinhnhietdo_h
    en: Tap on the refrigerator while it is open
    vn: "B\u1EA5m v\xE0o t\u1EE7 l\u1EA1nh khi n\xF3 \u0111ang m\u1EDF"
  - key: chuotduoibinhnuoc_h
    en: Swipe the water tank up
    vn: "Vu\u1ED1t b\xECnh n\u01B0\u1EDBc l\xEAn"
  - key: tulanh_s
    en: They're all over the fridge!
    vn: "Ch\xFAng c\xF3 \u0111\u1EA7y trong t\u1EE7 l\u1EA1nh!"
  - key: tulanh_h
    en: Tap on the refrigerator to open it
    vn: "B\u1EA5m v\xE0o t\u1EE7 l\u1EA1nh \u0111\u1EC3 m\u1EDF ra"
  - key: goi_h
    en: Swipe the pillow on the sofa to the left
    vn: "Vu\u1ED1t g\u1ED1i tr\xEAn sofa qua b\xEAn tr\xE1i"
  - key: win_s
    en: That was scary
    vn: "V\u1EEBa r\u1ED3i th\u1EADt \u0111\xE1ng s\u1EE3"
  - key: intro_s
    en: I just moved into this new house, and there are rats everywhere!
    vn: "T\xF4i v\u1EEBa chuy\u1EC3n v\xE0o nh\xE0 m\u1EDBi \u1EDF, v\xE0 chu\u1ED9t
      \u1EDF m\u1ECDi n\u01A1i!"
  - key: thuocdoc_s
    en: Let them taste some liquid rat poison
    vn: "Cho ch\xFAng n\u1EBFm ch\xFAt thu\u1ED1c chu\u1ED9t d\u1EA1ng l\u1ECFng"
  - key: chuottu_h
    en: Drag the spray can to the mouse on the wooden cabinet above the refrigerator
    vn: "K\xE9o b\xECnh x\u1ECBt v\xE0o chu\u1ED9t tr\xEAn t\u1EE7 g\u1ED7 ph\xEDa
      tr\xEAn t\u1EE7 l\u1EA1nh"
