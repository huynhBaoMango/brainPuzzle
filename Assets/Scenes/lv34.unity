  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Mom is back
    vn: "M\u1EB9 v\u1EC1"
  - key: des
    en: Clean the house before mom comes in
    vn: "D\u1ECDn nh\xE0 ts\u1EA1ch s\u1EBD tr\u01B0\u1EDBc khi m\u1EB9 v\xE0o nh\xE0"
  - key: rac3_s
    en: Throw it all in the trash
    vn: "Nh\xE9t h\u1EBFt v\xE0o th\xF9ng r\xE1c"
  - key: rac3_h
    en: Drag the trash on the chair to the trash can
    vn: "K\xE9o \u0111\u1ED1ng r\xE1c tr\xEAn gh\u1EBF v\xE0o th\xF9ng r\xE1c"
  - key: mayhut_s
    en: 
    vn: 
  - key: mayhut_h
    en: Drag the vacuum cleaner into the pile of dust on the floor
    vn: "K\xE9o m\xE1y h\xFAt b\u1EE5i v\xE0o \u0111\u1ED1ng b\u1EE5i tr\xEAn s\xE0n"
  - key: rac2_s
    en: Throw it all in the trash
    vn: "Nh\xE9t h\u1EBFt v\xE0o th\xF9ng r\xE1c"
  - key: rac2_h
    en: Drag the trash into the trash can
    vn: "K\xE9o \u0111\u1ED1ng r\xE1c v\xE0o th\xF9ng r\xE1c"
  - key: trai_s
    en: Go into the closet and hide, handsome
    vn: "\u0110i v\xE0o t\u1EE7 n\xFAp \u0111i anh trai"
  - key: trai_h
    en: Drag the man into the cabinet on the left
    vn: "K\xE9o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng v\xE0o t\u1EE7 b\xEAn tr\xE1i"
  - key: rac1_s
    en: Throw it all in the trash
    vn: "Nh\xE9t h\u1EBFt v\xE0o th\xF9ng r\xE1c"
  - key: rac1_h
    en: Drag the trash into the trash can
    vn: "K\xE9o \u0111\u1ED1ng r\xE1c v\xE0o th\xF9ng r\xE1c"
  - key: rac4_s
    en: Throw it all in the trash
    vn: "Nh\xE9t h\u1EBFt v\xE0o th\xF9ng r\xE1c"
  - key: rac4_h
    en: Drag the trash into the trash can
    vn: "K\xE9o \u0111\u1ED1ng r\xE1c v\xE0o th\xF9ng r\xE1c"
  - key: binhxit_s
    en: Eliminates unpleasant odors
    vn: "Kh\u1EED c\xE1i m\xF9i h\xF4i kh\xF3 ch\u1ECBu"
  - key: binhxit_h
    en: Drag the spray bottle to the area where the odor is
    vn: "K\xE9o b\xECnh x\u1ECBt v\xE0o ch\u1ED7 c\xF3 m\xF9i h\xF4i"
  - key: choilongga_s
    en: Be ready to clean up cobwebs on the ceiling
    vn: "S\u1EB5n ti\u1EC7n d\u1ECDn m\u1EA1ng nh\u1EC7n tr\xEAn tr\u1EA7n"
  - key: choilongga_h
    en: Drag the feather duster into the spider web
    vn: "K\xE9o ch\u1ED5i l\xF4ng g\xE0 v\xE0o m\u1EA1ng nh\u1EC7n"
  - key: banhkem_s
    en: Cat, please hold the cake for me
    vn: "M\xE8o gi\u1EEF h\u1ED9 c\xE1i b\xE1nh cho ta"
  - key: banhkem_h
    en: Drag the cake onto the cat
    vn: "K\xE9o b\xE1nh kem v\xE0o con m\xE8o"
  - key: ketu_h
    en: Tap on the left cabinet door to open
    vn: "B\u1EA5m v\xE0o c\u1EEDa t\u1EE7 b\xEAn tr\xE1i \u0111\u1EC3 m\u1EDF"
