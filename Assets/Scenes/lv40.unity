MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 680400109}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv40
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: chancuon
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: ruongdo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: chan2
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: keo
    stateId: used_gaubong
    target: {fileID: 0}
  - type: 0
    targetId: cucbonggon
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: keo
    stateId: used_cogai
    target: {fileID: 0}
  - type: 0
    targetId: toc
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: keo
    stateId: used_meo
    target: {fileID: 0}
  - type: 0
    targetId: longmeo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: ghemeo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: remcua
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: trangtri
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: tham
    stateId: used
    target: {fileID: 0}
  loseConditions: []
  timeLimit: 120
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Cover up
    vn: "\u0110\u1EAFp ch\u0103n"
  - key: des
    en: It's getting cold. Help me stay warm while I sleep
    vn: "Tr\u1EDDi \u0111ang tr\u1EDF l\u1EA1nh, h\xE3y gi\xFAp t\xF4i c\xF3 m\u1ED9t
      gi\u1EA5c ng\u1EE7 \u1EA5m \xE1p"
  - key: tham_s
    en: This rug will keep me warm
    vn: "T\u1EA5m th\u1EA3m n\xE0y c\u0169ng \u0111\u1EE7 \u1EA5m"
  - key: bonggon_s
    en: Cotton works for warmth too
    vn: "B\xF4ng g\xF2n c\u0169ng gi\u1EEF \u1EA5m \u0111\u01B0\u1EE3c"
  - key: chan2_s
    en: Another blanket, I'm warmer now
    vn: "Th\xEAm m\u1ED9t c\xE1i ch\u0103n n\u1EEFa, \u1EA5m h\u01A1n r\u1ED3i"
  - key: trangtri_s
    en: A decoration works in a pinch
    vn: "\u0110\u1ED3 trang tr\xED c\u0169ng \u0111\u1EAFp \u0111\u1EE1 \u0111\u01B0\u1EE3c"
  - key: remcua_s
    en: A curtain makes a passable blanket
    vn: "R\xE8m c\u1EEDa l\xE0m ch\u0103n c\u0169ng t\u1EA1m"
  - key: thamyoga_s
    en: Yoga mat, surprisingly warm
    vn: "Th\u1EA3m yoga, \u1EA5m \xE1p b\u1EA5t ng\u1EDD"
  - key: ghemeo_s
    en: Just borrowing the cat's chair
    vn: "M\u01B0\u1EE3n gh\u1EBF c\u1EE7a m\xE8o ch\xFAt nh\xE9"
  - key: toc_s
    en: Lucky my hair is long
    vn: "May l\xE0 ta c\xF3 t\xF3c d\xE0i"
  - key: longmeo_s
    en: Cat fur is really warm
    vn: "L\xF4ng m\xE8o \u1EA5m th\u1EADt"
  - key: tham_h
    en: Drag the rug onto the girl
    vn: "K\xE9o t\u1EA5m th\u1EA3m v\xE0o c\xF4 g\xE1i"
  - key: bonggon_h
    en: Drag the cotton onto the girl
    vn: "K\xE9o b\xF4ng g\xF2n v\xE0o c\xF4 g\xE1i"
  - key: chan2_h
    en: Drag the blanket onto the girl
    vn: "K\xE9o ch\u0103n v\xE0o c\xF4 g\xE1i"
  - key: trangtri_h
    en: Drag the decoration onto the girl
    vn: "K\xE9o \u0111\u1ED3 trang tr\xED v\xE0o c\xF4 g\xE1i"
  - key: remcua_h
    en: Drag the curtain onto the girl
    vn: "K\xE9o r\xE8m c\u1EEDa v\xE0o c\xF4 g\xE1i"
  - key: thamyoga_h
    en: Drag the yoga mat onto the girl
    vn: "K\xE9o th\u1EA3m yoga v\xE0o c\xF4 g\xE1i"
  - key: ghemeo_h
    en: Drag the cat's chair onto the girl
    vn: "K\xE9o gh\u1EBF m\xE8o v\xE0o c\xF4 g\xE1i"
  - key: ruongdo_h
    en: Tap the chest to open it
    vn: "B\u1EA5m v\xE0o r\u01B0\u01A1ng \u0111\u1ED3 \u0111\u1EC3 m\u1EDF"
  - key: toc_h
    en: Drag the hair onto the girl
    vn: "K\xE9o t\xF3c v\xE0o c\xF4 g\xE1i"
  - key: longmeo_h
    en: Drag the cat fur onto the girl
    vn: "K\xE9o l\xF4ng m\xE8o v\xE0o c\xF4 g\xE1i"
  - key: keogaubong_h
    en: Drag the scissors onto the teddy bear
    vn: "K\xE9o c\xE1i k\xE9o v\xE0o g\u1EA5u b\xF4ng"
  - key: keocogai_h
    en: Drag the scissors onto the girl's hair
    vn: "K\xE9o c\xE1i k\xE9o v\xE0o t\xF3c c\xF4 g\xE1i"
  - key: keomeo_h
    en: Drag the scissors onto the cat
    vn: "K\xE9o c\xE1i k\xE9o v\xE0o m\xE8o"
