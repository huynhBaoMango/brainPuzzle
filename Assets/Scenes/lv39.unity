  strings:
  - key: tit
    en: Garbage classification
    vn: "Ph\xE2n lo\u1EA1i r\xE1c"
  - key: des
    en: Throw trash into its proper trash can
    vn: "V\u1EE9t r\xE1c v\xE0o \u0111\xFAng th\xF9ng r\xE1c c\u1EE7a ch\xFAng"
  - key: racthungcarton2_s
    en: This is recyclable
    vn: "Th\u1EE9 n\xE0y c\xF3 th\u1EC3 t\xE1i ch\u1EBF \u0111\u01B0\u1EE3c"
  - key: racthungcarton2_h
    en: Drag the carton into the recycling bin
    vn: "K\xE9o th\xF9ng carton v\xE0o th\xF9ng r\xE1c t\xE1i ch\u1EBF"
  - key: cay3_s
    en: Can be used as fertilizer
    vn: "C\xF3 th\u1EC3 d\xF9ng l\xE0m ph\xE2n b\xF3n"
  - key: cay3_h
    en: Drag potted plants into the bio-waste bin
    vn: "K\xE9o c\xE2y trong ch\u1EADu v\xE0o th\xF9ng r\xE1c sinh h\u1ECDc"
  - key: rac1_s
    en: Just throw this away
    vn: "Th\u1EE9 n\xE0y th\xEC v\u1EE9t \u0111i th\xF4i"
  - key: rac1_h
    en: Drag pizza boxes and food into the non-recycling bin
    vn: "K\xE9o h\u1ED9p b\xE1nh pizza v\xE0 \u0111\u1ED3 \u0103n v\xE0o th\xF9ng
      r\xE1c kh\xF4ng t\xE1i ch\u1EBF"
  - key: lytrong2_s
    en: This is recyclable
    vn: "Th\u1EE9 n\xE0y c\xF3 th\u1EC3 t\xE1i ch\u1EBF \u0111\u01B0\u1EE3c"
  - key: lytrong2_h
    en: Drag the glass into the recycling bin
    vn: "K\xE9o ly th\u1EE7y tinh v\xE0o th\xF9ng r\xE1c t\xE1i ch\u1EBF"
  - key: lynuocfull_h
    en: Drag the juice cup to the sink
    vn: "K\xE9o ly n\u01B0\u1EDBc \xE9p v\xE0o b\u1ED3n r\u1EEDa"
  - key: binhcf_h
    en: Tap on the coffee maker
    vn: "B\u1EA5m v\xE0o m\xE1y pha cafe"
  - key: cuatu_h
    en: Tap on the kitchen cabinet below
    vn: "B\u1EA5m v\xE0o t\u1EE7 b\u1EBFp ph\xEDa d\u01B0\u1EDBi"
  - key: raclon2_s
    en: This is recyclable
    vn: "Th\u1EE9 n\xE0y c\xF3 th\u1EC3 t\xE1i ch\u1EBF \u0111\u01B0\u1EE3c"
  - key: raclon2_h
    en: Drag the cans into the recycling bin
    vn: "K\xE9o v\u1ECF lon v\xE0o th\xF9ng r\xE1c t\xE1i ch\u1EBF"
  - key: lybe_s
    en: Just throw this away
    vn: "Th\u1EE9 n\xE0y th\xEC v\u1EE9t \u0111i th\xF4i"
  - key: lybe_h
    en: Drag broken glass into the non-recyclable trash
    vn: "K\xE9o ly th\u1EE7y tinh v\u1EE1 v\xE0o th\xF9ng r\xE1c kh\xF4ng t\xE1i
      ch\u1EBF"
  - key: cf1_s
    en: Just throw this away
    vn: "Th\u1EE9 n\xE0y th\xEC v\u1EE9t \u0111i th\xF4i"
  - key: cf1_h
    en: Drag coffee carcasses into non-recyclable trash
    vn: "K\xE9o x\xE1c cafe v\xE0o th\xF9ng r\xE1c kh\xF4ng t\xE1i ch\u1EBF"
  - key: racbia2_s
    en: This is recyclable
    vn: "Th\u1EE9 n\xE0y c\xF3 th\u1EC3 t\xE1i ch\u1EBF \u0111\u01B0\u1EE3c"
  - key: racbia2_h
    en: Drag the glass bottle into the recycling bin
    vn: "K\xE9o chai th\u1EE7y tinh v\xE0o th\xF9ng r\xE1c t\xE1i ch\u1EBF"
  - key: duahau3_s
    en: Can be used as fertilizer
    vn: "C\xF3 th\u1EC3 d\xF9ng l\xE0m ph\xE2n b\xF3n"
  - key: duahau3_h
    en: Drag the watermelon rind into the bio-waste bin
    vn: "K\xE9o v\u1ECF d\u01B0a h\u1EA5u v\xE0o th\xF9ng r\xE1c sinh h\u1ECDc"
  - key: chaucay2_s
    en: This is recyclable
    vn: "Th\u1EE9 n\xE0y c\xF3 th\u1EC3 t\xE1i ch\u1EBF \u0111\u01B0\u1EE3c"
  - key: chaucay2_h
    en: Drag the potted plant into the recycling bin
    vn: "K\xE9o ch\u1EADu c\xE2y v\xE0o th\xF9ng r\xE1c t\xE1i ch\u1EBF"
  - key: wrong_s
    en: Looks like it's wrong...
    vn: "H\xECnh nh\u01B0 l\xE0 sai r\u1ED3i..."
