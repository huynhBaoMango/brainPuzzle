    stateId: done
    target: {fileID: 0}
  - type: 0
    targetId: bangkeo
    stateId: used
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: cheo
    stateId: used_lose
    target: {fileID: 0}
  - type: 0
    targetId: thungphi
    stateId: used_lose
    target: {fileID: 0}
  - type: 0
