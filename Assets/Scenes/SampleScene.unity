    stateId: coido_lose
    target: {fileID: 0}
  defaultHintMessageKey: 
  strings:
  - key: title
    en: Boat sinking
    vn: "Ch\xECm thuy\u1EC1n"
  - key: des
    en: Rescue them from the sinking boat
    vn: "Gi\u1EA3i c\u1EE9u b\u1ECDn h\u1ECD kh\u1ECFi chi\u1EBFc thuy\u1EC1n ch\xECm"
  - key: thungphi_lose
    en: Without drums, the boat will sink
    vn: "Kh\xF4ng c\xF3 th\xF9ng phi, thuy\u1EC1n s\u1EBD ch\xECm"
  - key: thungphi_lose_hint
    en: Don't throw away the drum
    vn: "\u0110\u1EEBng v\u1EE9t th\xF9ng phi \u0111i"
  - key: tocnu_success
    en: Oh my hair :(
    vn: "\xD4i t\xF3c c\u1EE7a t\xF4i :("
  - key: tocnu_hint
    en: Use scissors to cut the girl's hair
    vn: "D\xF9ng k\xE9o \u0111\u1EC3 c\u1EAFt t\xF3c c\xF4 g\xE1i"
  - key: aonu_success
    en: That's my designer jacket!
    vn: "\xC1o kho\xE1c h\xE0ng hi\u1EC7u c\u1EE7a t\xF4i \u0111\u1EA5y!"
  - key: aonu_hint
    en: Swipe up to throw away the girl's jacket
    vn: "Vu\u1ED1t l\xEAn \u0111\u1EC3 v\u1EE9t \xE1o kho\xE1c c\u1EE7a c\xF4 g\xE1i"
  - key: tuinu_success
    en: My 5 kilos of cosmetics!
    vn: "5 k\xED m\u1EF9 ph\u1EA9m c\u1EE7a t\xF4i!"
  - key: tuinu_hint
    en: Swipe up to throw away the girl's bag
    vn: "Vu\u1ED1t l\xEAn \u0111\u1EC3 v\u1EE9t t\xFAi c\u1EE7a c\xF4 g\xE1i"
  - key: tocnam_success
    en: That's my wig
    vn: "\u0110\xF3 l\xE0 t\xF3c gi\u1EA3 c\u1EE7a t\xF4i m\xE0"
  - key: tocnam_hint
    en: Swipe up to remove the crossdresser's hair
    vn: "Vu\u1ED1t l\xEAn \u0111\u1EC3 v\u1EE9t b\u1ECF t\xF3c c\u1EE7a ng\u01B0\u1EDDi
      gi\u1EA3 g\xE1i"
  - key: vaynam_success
    en: It's so embarrassing
    vn: "Th\u1EADt ng\u1EA1i qu\xE1"
  - key: vaynam_hint
    en: Swipe up to remove the crossdresser's dress
    vn: "Vu\u1ED1t l\xEAn \u0111\u1EC3 v\u1EE9t b\u1ECF v\xE1y c\u1EE7a ng\u01B0\u1EDDi
      gi\u1EA3 g\xE1i"
  - key: tatnuoc_success
    en: Let me splash the water out
    vn: "\u0110\u1EC3 t\xF4i t\xE1t n\u01B0\u1EDBc ra"
  - key: tatnuoc_hint
    en: Drag the bucket onto the crossdresser after throwing away her hair dress
    vn: "K\xE9o c\xE1i x\xF4 v\xE0o ng\u01B0\u1EDDi gi\u1EA3 g\xE1i sau khi v\u1EE9t
      b\u1ECF v\xE1y t\xF3c"
  - key: onggiatre_success
    en: I feel full of youthful energy
    vn: "Ta c\u1EA3m th\u1EA5y s\u1EE9c tr\u1EBB d\u1ED3i d\xE0o"
  - key: onggiatre_hint
    en: Drag the clock on the old man
    vn: "K\xE9o \u0111\u1ED3ng h\u1ED3 v\xE0o \xF4ng l\xE3o"
  - key: onggiacoido_success
    en: I used to be that superhero
    vn: "Ta t\u1EEBng l\xE0 si\xEAu nh\xE2n \u0111\xF3"
  - key: onggiacoido_hint
    en: Swipe up to undress the old man after rejuvenation
    vn: "Vu\u1ED1t l\xEAn \u0111\u1EC3 c\u1EDFi \u0111\u1ED3 c\u1EE7a \xF4ng gi\xE0
      sau khi tr\u1EBB h\xF3a"
  - key: onggia_lose
    en: So cold...
    vn: "L\u1EA1nh qu\xE1..."
  - key: onggia_lose_hint
    en: Don't take off the old man's clothes first
    vn: "\u0110\u1EEBng c\u1EDFi \u0111\u1ED3 c\u1EE7a \xF4ng gi\xE0 tr\u01B0\u1EDBc
      ti\xEAn"
  - key: cheo_used_lose
    en: Without a paddle, how can you get back to shore?
    vn: "Kh\xF4ng c\xF3 c\xE1i ch\xE8o th\xEC sao v\u1EC1 \u0111\u01B0\u1EE3c b\u1EDD
      ch\u1EE9"
  - key: cheo_lose_hint
    en: Don't throw away the oar
    vn: "\u0110\u1EEBng v\u1EE9t b\u1ECF c\xE1i ch\xE8o"
  - key: kimco_success
    en: I watched Journey to the West for more than 180 minutes
    vn: "T\xF4i \u0111\xE3 xem t\xE2y du k\xED h\u01A1n 180 ph\xFAt"
  - key: kimco_hint
    en: Drag the mask on the boy
    vn: "K\xE9o m\u1EB7t n\u1EA1 v\xE0o c\u1EADu b\xE9"
  - key: may_success
    en: Goodbye hehehe
    vn: "T\xF4i \u0111i tr\u01B0\u1EDBc \u0111\xE2y hehehe"
  - key: may_hint
    en: Drag the cloud onto the boy after putting on the mask
    vn: "K\xE9o \u0111\xE1m m\xE2y v\xE0o c\u1EADu b\xE9 sau khi \u0111eo m\u1EB7t
      n\u1EA1"
  - key: cho_success
    en: Dogs can swim on their own
    vn: "Ch\xF3 c\xF3 th\u1EC3 t\u1EF1 b\u01A1i m\xE0"
  - key: cho_hint
    en: Swipe up to throw away the dog
    vn: "Vu\u1ED1t l\xEAn \u0111\u1EC3 v\u1EE9t con ch\xF3"
  - key: bangkeo_success
    en: The ship is no longer leaking
    vn: "T\xE0u kh\xF4ng l\u1EE7ng n\u1EEFa"
  - key: bangkeo_hint
    en: Drag the tape into the hole
    vn: "K\xE9o cu\u1ED9n b\u0103ng keo v\xE0o l\u1ED7 l\u1EE7ng"
  - key: vali_success
    en: This suitcase weighs as much as my bag!
    vn: "C\xE1i vali n\xE0y n\u1EB7ng ngang ng\u1EEDa t\xFAi c\u1EE7a t\xF4i!"
  - key: vali_hint
    en: Swipe up to dispose of the suitcase
    vn: "Vu\u1ED1t l\xEAn \u0111\u1EC3 v\u1EE9t b\u1ECF c\xE1i vali"
