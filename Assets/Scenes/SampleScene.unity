  defaultHintMessageKey: 
  strings:
  - key: title
    en: Girlfriend is angry
    vn: "B\u1EA1n g\xE1i gi\u1EADn"
  - key: hat_success
    en: She likes to listen to me sing
    vn: "C\xF4 \u1EA5y th\xEDch nghe t\xF4i h\xE1t"
  - key: hat_hint
    en: Drag the microphone on the guy
    vn: "K\xE9o micro v\xE0o ch\xE0ng trai"
  - key: nhan_success
    en: She'll love the ring
    vn: "C\xF4 \u1EA5y s\u1EBD th\xEDch nh\u1EABn th\xF4i"
  - key: nhan_hint
    en: Drag the ring onto the man
    vn: "K\xE9o nh\u1EABn v\xE0o ch\xE0ng trai"
  - key: vit_success
    en: Play with her to improve her mood
    vn: "Ch\u01A1i v\u1EDBi c\xF4 \u1EA5y \u0111\u1EC3 t\xE2m tr\u1EA1ng c\xF4 \u1EA5y
      t\u1ED1t h\u01A1n"
  - key: vit_hint
    en: Drag the duck on the guy
    vn: "K\xE9o v\u1ECBt v\xE0o ch\xE0ng trai"
  - key: banh_success
    en: She really likes cake
    vn: "C\xF4 \u1EA5y r\u1EA5t th\xEDch b\xE1nh"
  - key: banh_hint
    en: Drag the cake on the guy
    vn: "K\xE9o b\xE1nh v\xE0o ch\xE0ng trai"
  - key: hoa_success
    en: Giving her flowers will make her less angry
    vn: "T\u1EB7ng hoa s\u1EBD l\xE0m c\xF4 \u1EA5y b\u1EDBt gi\u1EADn"
  - key: hoa_hint
    en: Drag the cloud to the bush to make the flowers grow
    vn: "K\xE9o \u0111\xE1m m\xE2y v\xE0o b\u1EE5i c\xE2y \u0111\u1EC3 hoa m\u1ECDc"
  - key: long_success_lose
    en: She's angrier now
    vn: "C\xF4 \u1EA5y t\u1EE9c gi\u1EADn h\u01A1n r\u1ED3i"
  - key: long_lose_hint
    en: Don't use feathers
    vn: "\u0110\u1EEBng s\u1EED d\u1EE5ng l\xF4ng v\u0169"
  - key: hun_success
    en: Who can resist a kiss?
    vn: "Ai m\xE0 c\u01B0\u1EE1ng l\u1EA1i m\u1ED9t n\u1EE5 h\xF4n ch\u1EE9"
  - key: hun_hint
    en: Tap the girl's face
    vn: "Ch\u1EA1m v\xE0o m\u1EB7t c\u1EE7a c\xF4 g\xE1i"
  - key: kem_success
    en: Rub sunscreen on her
    vn: "Xoa kem ch\u1ED1ng n\u1EAFng cho c\xF4 \u1EA5y"
  - key: kem_hint
    en: Drag sunscreen on the guy
    vn: "K\xE9o kem ch\u1ED1ng n\u1EAFng v\xE0o ch\xE0ng trai"
  - key: chan_success
    en: She wants a massage
    vn: "C\xF4 \u1EA5y mu\u1ED1n \u0111\u01B0\u1EE3c m\xE1t xa"
  - key: chan_hint
    en: Tap the girl's feet
    vn: "Ch\u1EA1m v\xE0o ch\xE2n c\u1EE7a c\xF4 g\xE1i"
  - key: nam_doneall_success
    en: She's temporarily calmed down
    vn: "C\xF4 \u1EA5y t\u1EA1m h\u1EBFt gi\u1EADn r\u1ED3i"
  - key: gaidep_lose
    en: She's angrier now
    vn: "C\xF4 \u1EA5y gi\u1EADn h\u01A1n r\u1ED3i"
  - key: gaidep_lose_hint
    en: Don't touch the girl in the swimming pool
    vn: "\u0110\u1EEBng ch\u1EA1m v\xE0o c\xF4 g\xE1i trong b\u1EC3 b\u01A1i"
  - key: des
    en: Calm your girlfriend out of her anger
    vn: "D\u1ED7 cho b\u1EA1n g\xE1i h\u1EBFt gi\u1EADn"
  - key: may_hint
    en: 
    vn: 
