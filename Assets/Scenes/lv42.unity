MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 931492595}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv42
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: tenlua
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: napbinhdau
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: chan_interact
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: cole
    stateId: used_banhtruoc
    target: {fileID: 0}
  - type: 0
    targetId: cole
    stateId: used_banhsau
    target: {fileID: 0}
  - type: 0
    targetId: keo
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: da
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: o1
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: xemain
    stateId: win2
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: boto
    stateId: used_lose
    target: {fileID: 0}
  timeLimit: 90
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Stop the bike
    vn: "D\u1EEBng xe"
  - key: des
    en: Find a way to stop the bike before it's too late!
    vn: "T\xECm c\xE1ch d\u1EEBng chi\u1EBFc xe l\u1EA1i tr\u01B0\u1EDBc khi qu\xE1
      mu\u1ED9n!"
  - key: keo_s
    en: Let the hair stuck in the exhaust pipe
    vn: "T\xF3c l\xE0m k\u1EB9t b\xF4 xe r\u1ED3i"
  - key: keo_h
    en: Drag the scissors onto the girl
    vn: "K\xE9o c\xE2y k\xE9o v\xE0o c\xF4 g\xE1i"
  - key: chaninteract_s
    en: Use my feet to brake
    vn: "D\xF9ng ch\xE2n \u0111\u1EC3 th\u1EAFng l\u1EA1i"
  - key: chaninteract_h
    en: Click on the girl's legs
    vn: "B\u1EA5m v\xE0o ch\xE2n c\u1EE7a c\xF4 g\xE1i"
  - key: coletruoc_s
    en: Take the wheel off
    vn: "Th\xE1o b\xE1nh xe ra lu\xF4n"
  - key: coletruoc_h
    en: Drag the wrench onto the front wheel
    vn: "K\xE9o c\u1EDD l\xEA v\xE0o b\xE1nh xe"
  - key: colesau_s
    en: Take the wheel off
    vn: "Th\xE1o b\xE1nh xe ra lu\xF4n"
  - key: colesau_h
    en: Drag the wrench onto the rear wheel
    vn: "K\xE9o c\u1EDD l\xEA v\xE0o b\xE1nh xe"
  - key: win
    en: It finally stopped!
    vn: "Cu\u1ED1i c\xF9ng c\u0169ng d\u1EEBng l\u1EA1i r\u1ED3i!"
  - key: used_lose_s
    en: This exhaust pipe makes the bike go even faster
    vn: "C\xE1i b\xF4 n\xE0y l\xE0m xe ch\u1EA1y nhanh h\u01A1n n\u1EEFa"
  - key: used_lose_h
    en: Don't use the loose exhaust pipe on the ground
    vn: "\u0110\u1EEBng s\u1EED d\u1EE5ng c\xE1i b\xF4 xe d\u01B0\u1EDBi \u0111\u1EA5t"
  - key: napbinhdau_s
    en: Open the cap and let the oil drain out
    vn: "M\u1EDF n\u1EAFp cho ch\u1EA3y h\u1EBFt d\u1EA7u ra"
  - key: napbinhdau_h
    en: Tap the oil cap on the bike, it's on the right of the girl's leg
    vn: "B\u1EA5m v\xE0o n\u1EAFp d\u1EA7u tr\xEAn th\xE2n xe, n\xF3 \u1EDF ph\xEDa
      b\xEAn ph\u1EA3i ch\xE2n c\u1EE7a c\xF4 g\xE1i"
  - key: o1_s
    en: The umbrella opens up and slows the bike down
    vn: "Bung chi\u1EBFc \xF4 ra l\xE0m ch\u1EADm xe l\u1EA1i"
  - key: o1_h
    en: Tap the umbrella at the rear of the bike
    vn: "B\u1EA5m v\xE0o chi\u1EBFc \xF4 \u1EDF \u0111u\xF4i xe"
  - key: tenlua_s
    en: The rocket brings the bike to a halt
    vn: "T\xEAn l\u1EEDa ng\u0103n chi\u1EBFc xe l\u1EA1i"
  - key: tenlua_h
    en: Drag the rocket onto the bike
    vn: "K\xE9o t\xEAn l\u1EEDa v\xE0o chi\u1EBFc  xe"
  - key: da_s
    en: Hooking the rock onto the bike slows it right down
    vn: "M\xF3c c\u1EE5c \u0111\xE1 v\xE0o xe l\xE0m n\xF3 ch\u1EADm l\u1EA1i"
  - key: da_h
    en: Drag the rock from the ground onto the bike
    vn: "K\xE9o c\u1EE5c \u0111\xE1 d\u01B0\u1EDBi \u0111\u1EA5t v\xE0o xe"
