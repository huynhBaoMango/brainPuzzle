    targetId: boncau2
    stateId: used
    target: {fileID: 0}
  - type: 0
    targetId: nam9
    stateId: win
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: nam9
    stateId: lose_phomai
    target: {fileID: 0}
  - type: 0
    targetId: nam9
    stateId: lose_pizza
    target: {fileID: 0}
  timeLimit: 0
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Losing weight
    vn: "Gi\u1EA3m c\xE2n"
  - key: des
    en: Find every possible way to lose weight and become a handsome man
    vn: "T\xECm m\u1ECDi c\xE1ch c\xF3 th\u1EC3 \u0111\u1EC3 gi\u1EA3m c\xE2n th\xE0nh
      so\xE1i ca"
  - key: remcuaso_h
    en: Tap on the window curtain on the wall
    vn: "B\u1EA5m v\xE0o r\xE8m c\u1EEDa s\u1ED5 tr\xEAn t\u01B0\u1EDDng"
  - key: bong1_h
    en: Drag the balloons on the floor to the faucet on the man's right
    vn: "K\xE9o bong b\xF3ng tr\xEAn s\xE0n v\xE0o v\xF2i n\u01B0\u1EDBc ph\xEDa
      b\xEAn ph\u1EA3i ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: binhtuoi_h
    en: Drag the watering can into the plant pot
    vn: "K\xE9o b\xECnh t\u01B0\u1EDBi v\xE0o ch\u1EADu c\xE2y"
  - key: xe_s
    en: Borrow this car too
    vn: "M\u01B0\u1EE3n chi\u1EBFc xe n\xE0y lu\xF4n nh\xE9"
  - key: xe_h
    en: Drag the car onto the man
    vn: "K\xE9o chi\u1EBFc xe v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: bua_h
    en: Drag the hammer to the corner of the cracked wall on the left
    vn: "K\xE9o chi\u1EBFc b\xFAa v\xE0o g\xF3c t\u01B0\u1EDDng b\u1ECB n\u1EE9t
      b\xEAn tr\xE1i"
  - key: xo_h
    en: Drag two buckets at the man
    vn: "K\xE9o 2 chi\u1EBFc x\xF4 v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: phomai_h
    en: Drag the cheese to the mouse on the wall
    vn: "K\xE9o ph\xF4 mai v\xE0o con chu\u1ED9t tr\xEAn t\u01B0\u1EDDng"
  - key: phomai_lose_s
    en: I'll start dieting tomorrow instead
    vn: "Th\xF4i th\xEC \u0111\u1EC3 mai gi\u1EA3m c\xE2n v\u1EADy"
  - key: phomai_lose_h
    en: Don't give the man cheese
    vn: "\u0110\u1EEBng \u0111\u01B0a ph\xF4 mai cho ng\u01B0\u1EDDi \u0111\xE0n
      \xF4ng"
  - key: boncau1_h
    en: Tap on the toilet twice
    vn: "B\u1EA5m v\xE0o b\u1ED3n c\u1EA7u 2 l\u1EA7n"
  - key: ran_s
    en: Don't bite me
    vn: "\u0110\u1EEBng c\u1EAFn ta nh\xE9"
  - key: ran_h
    en: Drag the snake into the man
    vn: "K\xE9o r\u1EAFn v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: pizza_lose_s
    en: I'll start dieting tomorrow instead
    vn: "Th\xF4i th\xEC \u0111\u1EC3 mai gi\u1EA3m c\xE2n v\u1EADy"
  - key: pizza_lose_h
    en: Don't give the pizza man
    vn: "\u0110\u1EEBng cho ng\u01B0\u1EDDi \u0111\xE0n \xF4ng pizza"
  - key: caube_s
    en: Borrow the boy for a while
    vn: "M\u01B0\u1EE3n c\u1EADu b\xE9 m\u1ED9t l\xFAc"
  - key: caube_h
    en: Drag the boy to the man
    vn: "K\xE9o c\u1EADu b\xE9 v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: bong_s
    en: Use this pair of balloons
    vn: "S\u1EED d\u1EE5ng c\u1EB7p b\xF3ng bay n\xE0y"
  - key: bong_h
    en: Drag the balloons onto the man
    vn: "K\xE9o bong b\xF3ng v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: saurieng_s
    en: Mmm, that smells delicious!
    vn: "Th\u01A1m qu\xE1, th\u1EADt h\u1EA5p d\u1EABn"
  - key: saurieng_h
    en: Drag durian on the man
    vn: "K\xE9o s\u1EA7u ri\xEAng v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: boncau2_s
    en: This toilet is also fine as a weight
    vn: "B\u1ED3n c\u1EA7u n\xE0y l\xE0m t\u1EA1 c\u0169ng \u1ED5n"
  - key: buoncau2_h
    en: Drag the toilet onto the man
    vn: "K\xE9o b\u1ED3n c\u1EA7u v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: chuot2_s
    en: Now that you're full, go help him
    vn: "B\xE9o r\u1ED3i th\xEC gi\xFAp c\u1EADu ta \u0111i "
  - key: chuot2_h
    en: Drag the mouse on the man
    vn: "K\xE9o chu\u1ED9t v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
  - key: nu_s
    en: I'm not that heavy, you know
    vn: "T\xF4i c\u0169ng kh\xF4ng n\u1EB7ng l\u1EAFm \u0111\xE2u"
  - key: nu_h
    en: Drag the girl to the man
    vn: "K\xE9o c\xF4 g\xE1i v\xE0o ng\u01B0\u1EDDi \u0111\xE0n \xF4ng"
