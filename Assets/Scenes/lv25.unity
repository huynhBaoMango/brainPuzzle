--- !u!114 &805869229
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 805869228}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81d4f036d83c1a345824d67d45678f9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::B_LevelConfig
  levelId: lv25
  title: tit
  description: des
  virtualWidth: 1080
  virtualHeight: 1920
  levelCamera: {fileID: 0}
  pixelsPerUnit: 100
  winConditions:
  - type: 0
    targetId: baQueue
    stateId: may
    target: {fileID: 0}
  - type: 0
    targetId: baQueue
    stateId: ongnuoc
    target: {fileID: 0}
  - type: 0
    targetId: baQueue
    stateId: bongnhay
    target: {fileID: 0}
  - type: 0
    targetId: baQueue
    stateId: bayup
    target: {fileID: 0}
  - type: 0
    targetId: baQueue
    stateId: moc
    target: {fileID: 0}
  - type: 0
    targetId: baQueue
    stateId: xao
    target: {fileID: 0}
  - type: 0
    targetId: baQueue
    stateId: chim
    target: {fileID: 0}
  - type: 0
    targetId: baQueue
    stateId: bongbay
    target: {fileID: 0}
  - type: 0
    targetId: baQueue
    stateId: khanchoang
    target: {fileID: 0}
  loseConditions:
  - type: 0
    targetId: quat
    stateId: used_lose
    target: {fileID: 0}
  timeLimit: 0
  timeUpTarget: {fileID: 0}
  timeUpStateId: 
  defaultHintMessageKey: 
  strings:
  - key: tit
    en: Escape the fire
    vn: "Tho\xE1t kh\u1ECFi h\u1ECFa ho\u1EA1n"
  - key: des
    en: Help the old ladies get to a safe place
    vn: "Gi\xFAp c\xE1c b\xE0 c\u1EE5 \u0111\u1EBFn \u0111\u01B0\u1EE3c n\u01A1i
      an to\xE0n"
  - key: may_s
    en: Cloud, carry granny across!
    vn: "M\xE2y kia \u0111\u01B0a b\xE0 qua!"
  - key: may_h
    en: Pull the cloud onto the old lady
    vn: "K\xE9o \u0111\xE1m m\xE2y v\xE0o b\xE0 c\u1EE5"
  - key: ongnuoc_s
    en: Watch your step, granny!
    vn: "\u0110i qua c\u1EA9n th\u1EADn b\xE0 \u01A1i!"
  - key: ongnuoc_h
    en: Pull the water pipe in the middle below to the old lady
    vn: "K\xE9o \u1ED1ng n\u01B0\u1EDBc \u1EDF gi\u1EEFa b\xEAn d\u01B0\u1EDBi v\xE0o
      b\xE0 c\u1EE5"
  - key: bongnhay_s
    en: I used to practice yoga when I was young
    vn: "Ta t\u1EEBng t\u1EADp yoga l\xFAc tr\u1EBB"
  - key: bongnhay_h
    en: Drag the yoga ball on the right to the old lady
    vn: "K\xE9o b\xF3ng t\u1EADp yoga \u1EDF b\xEAn ph\u1EA3i v\xE0o b\xE0 c\u1EE5"
  - key: bayup_s
    en: Flying over was easy
    vn: "Bay qua th\u1EADt d\u1EC5 d\xE0ng"
  - key: bayup_h
    en: Pull the soft drink bottle on the right to the old lady
    vn: "K\xE9o chai n\u01B0\u1EDBc ng\u1ECDt \u1EDF b\xEAn ph\u1EA3i v\xE0o b\xE0
      c\u1EE5"
  - key: xao_s
    en: Watch your step, granny!
    vn: "\u0110i qua c\u1EA9n th\u1EADn b\xE0 \u01A1i!"
  - key: xao_h
    en: Pull up the clothesline on the right side of the old lady
    vn: "K\xE9o x\xE0o ph\u01A1i \u0111\u1ED3 \u1EDF b\xEAn ph\u1EA3i v\xE0o b\xE0
      c\u1EE5"
  - key: chim_s
    en: Cling to this bird!
    vn: "B\xE1m l\u1EA5y con chim n\xE0y!"
  - key: chim_h
    en: Pull the bird from the sky to the old lady
    vn: "K\xE9o chim tr\xEAn tr\u1EDDi v\xE0o b\xE0 c\u1EE5"
  - key: moc_s
    en: It's like going on a zipline!
    vn: "C\u1EE9 nh\u01B0 \u0111i zipline v\u1EADy!"
  - key: moc_h
    en: Pull the clothes hanger onto the old lady
    vn: "K\xE9o c\xE1i m\xF3c ph\u01A1i \u0111\u1ED3 v\xE0o b\xE0 c\u1EE5"
  - key: bongbay_s
    en: I learn from the movie Up!
    vn: "Ta h\u1ECDc theo phim Up!"
  - key: bongbay_h
    en: Drag the balloon between the two buildings to the old lady
    vn: "K\xE9o b\xF3ng bay \u1EDF gi\u1EEFa hai t\xF2a nh\xE0 v\xE0o b\xE0 c\u1EE5"
  - key: khanchoang_s
    en: I can get through on my own
    vn: "Ta c\xF3 th\u1EC3 t\u1EF1 qua \u0111\u01B0\u1EE3c"
  - key: khanchoang_h
    en: Pull the red shawl on the old lady
    vn: "K\xE9o kh\u0103n cho\xE0ng m\xE0u \u0111\u1ECF v\xE0o b\xE0 c\u1EE5"
  - key: quat_lose_s
    en: The fire is even bigger!
    vn: "L\u1EEDa l\u1EDBn h\u01A1n n\u1EEFa r\u1ED3i!"
  - key: quat_lose_h
    en: Don't use the fan
    vn: "\u0110\u1EEBng s\u1EED d\u1EE5ng c\xE1i qu\u1EA1t"
